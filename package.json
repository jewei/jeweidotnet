{
  "name": "jeweidotnet",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun scripts/build-markdown.ts",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "bun test",
    "test:content": "bun test tests/content.test.ts",
    "test:build": "bun test tests/build.test.ts tests/middleware.test.ts",
    "verify": "bun run check && bun run test:content && bun run build && bun run test:build",
    "shots": "bun scripts/screenshots.ts",
    "optimize:og": "bun scripts/optimize-og-image.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "astro": "^7.3.5",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "satori": "^0.35.0",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/turndown": "^5.0.6",
    "typescript": "^6.0.3"
  }
}
