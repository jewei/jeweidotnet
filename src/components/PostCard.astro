---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { postUrl, shortDateFormatter as dateFormatter } from '../support/blog';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  variant: 'pinned' | 'grid' | 'list';
  index?: number;
  currentTag?: string;
}

const { post, variant, currentTag } = Astro.props;
const { title, description, pubDate, tags, image } = post.data;

---

{
  variant === 'pinned' && (
    <a
      href={postUrl(post.id)}
      class="post-card post-card--pinned"
    >
      <div class:list={["post-card__split", !image && "post-card__split--text-only"]}>
        {image && (
          <div class="post-card__media">
            <Image
              src={image}
              alt={title}
              layout="none"
              widths={[400, 600, 800]}
              sizes="(min-width: 768px) 40vw, 100vw"
              format="webp"
              loading="lazy"
              decoding="async"
              class="post-card__image"
            />
          </div>
        )}
        <div class="post-card__body">
          {tags.length > 0 && (
            <div class="post-card__tags">
              {tags.slice(0, 3).map((tag) => (
                <span class="post-tag">
                  {tag}
                </span>
              ))}
              {tags.length > 3 && (
                <span class="post-tag post-tag--more">
                  +{tags.length - 3}
                </span>
              )}
            </div>
          )}
          <h3 class="post-card__title">
            {title}
          </h3>
          <p class="post-card__description">
            {description}
          </p>
          <div class="post-card__meta">
            <Icon name="calendar_month" class="text-[16px]" />
            <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
          </div>
        </div>
      </div>
    </a>
  )
}

{
  variant === 'grid' && (
    <a
      href={postUrl(post.id)}
      class="post-card post-card--grid"
    >
      {tags.length > 0 && (
        <div class="post-card__tags">
          {tags.slice(0, 2).map((tag) => (
            <span class="post-tag">
              {tag}
            </span>
          ))}
          {tags.length > 2 && (
            <span class="post-tag post-tag--more">
              +{tags.length - 2}
            </span>
          )}
        </div>
      )}
      <h3 class="post-card__title">
        {title}
      </h3>
      <p class="post-card__description">
        {description}
      </p>
      <div class="post-card__meta">
        <Icon name="calendar_month" class="text-[14px]" />
        <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
      </div>
    </a>
  )
}

{
  variant === 'list' && (
    <a
      href={postUrl(post.id)}
      class="post-card post-card--list"
    >
      <div class="post-card__meta post-card__meta--top">
        <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
        {currentTag
          ? tags.length > 1 && (
              <>
                <span aria-hidden="true">·</span>
                <div class="post-card__tags">
                  {tags
                    .filter((t) => t !== currentTag)
                    .slice(0, 2)
                    .map((tag) => (
                      <span class="post-tag">
                        {tag}
                      </span>
                    ))}
                </div>
              </>
            )
          : tags.length > 0 && (
              <>
                <span aria-hidden="true">·</span>
                <div class="post-card__tags">
                  {tags.map((tag) => (
                    <span class="post-tag">
                      {tag}
                    </span>
                  ))}
                </div>
              </>
            )}
      </div>
      <h2 class="post-card__title">
        {title}
      </h2>
      <p class="post-card__description">
        {description}
      </p>
      <div class="post-card__action">
        Read
        <Icon name="arrow_forward" class="text-sm" />
      </div>
    </a>
  )
}
