---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatTagName, postUrl, shortDateFormatter as dateFormatter, tagToSlug } from '../support/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  variant: 'pinned' | 'list';
  currentTag?: string;
  headingLevel?: 2 | 3 | 4;
}

const { post, variant, currentTag, headingLevel = variant === 'list' ? 2 : 3 } = Astro.props;
const { title, description, pubDate, tags, image, imageAlt } = post.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const visibleTags = tags.filter((tag) => tag !== currentTag);
---

{
  variant === 'pinned' && (
    <article class="post-card post-card--pinned">
      {image && (
        <a
          class="post-card__media"
          href={postUrl(post.id)}
          aria-label={`Read ${title}`}
        >
          <Image
            src={image}
            alt={imageAlt ?? ''}
            class="post-card__image"
            widths={[400, 640, 900]}
            sizes="(min-width: 960px) 36rem, (min-width: 640px) 48vw, 100vw"
            layout="none"
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </a>
      )}

      <div class="post-card__body">
        <div class="post-card__meta">
          <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
          {visibleTags.length > 0 && (
            <ul class="post-card__topics" aria-label="Topics">
              {visibleTags.map((tag) => (
                <li>
                    <a href={`/blog/${tagToSlug(tag)}/`}>{formatTagName(tag)}</a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <Heading class="post-card__title">
          <a href={postUrl(post.id)}>{title}</a>
        </Heading>
        <p class="post-card__description">{description}</p>
        <a class="text-link post-card__action" href={postUrl(post.id)}>
          Read article
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>
  )
}

{
  variant === 'list' && (
    <article class="post-card post-card--list">
      <div class="post-card__meta">
        <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
        {visibleTags.length > 0 && (
          <ul class="post-card__topics" aria-label="Topics">
            {visibleTags.map((tag) => (
              <li>
                <a href={`/blog/${tagToSlug(tag)}/`}>{formatTagName(tag)}</a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <Heading class="post-card__title">
        <a href={postUrl(post.id)}>{title}</a>
      </Heading>
      <p class="post-card__description">{description}</p>
    </article>
  )
}
