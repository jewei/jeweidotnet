---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { tagColors, postUrl, shortDateFormatter as dateFormatter } from '../support/blog';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  variant: 'pinned' | 'grid' | 'list';
  index?: number;
  currentTag?: string;
}

const { post, variant, index = 0, currentTag } = Astro.props;
const { title, description, pubDate, tags, image } = post.data;

const cardGradients = [
  'from-primary/10 via-surface-container to-surface-container-lowest',
  'from-secondary/10 via-surface-container to-surface-container-lowest',
  'from-tertiary/10 via-surface-container to-surface-container-lowest',
];
---

{
  variant === 'pinned' && (
    <a
      href={postUrl(post.id)}
      class="group block relative overflow-hidden rounded-xl bg-surface-container-lowest dark:bg-surface-dark border border-outline-variant/30 hover:-translate-y-1 hover:shadow-xl active:translate-y-0 active:scale-[0.99] active:duration-100 transition-all duration-300"
    >
      <div class="flex flex-col md:flex-row h-full">
        <div class="md:w-2/5 h-48 md:h-auto relative overflow-hidden flex-shrink-0">
          {image ? (
            <Image
              src={image}
              alt={title}
              layout="none"
              widths={[400, 600, 800]}
              sizes="(min-width: 768px) 40vw, 100vw"
              format="webp"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          ) : (
            <>
              <div class="absolute inset-0 bg-gradient-to-br from-primary/20 via-secondary/10 to-tertiary/10" />
              <div class="absolute inset-0 bg-gradient-to-tr from-primary/30 to-secondary/20 group-hover:scale-105 transition-transform duration-500" />
              <svg
                class="absolute inset-0 m-auto w-16 h-16 text-primary/20"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M12 0l2.5 9.5L24 12l-9.5 2.5L12 24l-2.5-9.5L0 12l9.5-2.5z" />
              </svg>
            </>
          )}
        </div>
        <div class="flex-1 p-6 md:p-8 flex flex-col justify-center">
          {tags.length > 0 && (
            <div class="flex items-center gap-2 mb-4 flex-wrap">
              {tags.slice(0, 3).map((tag, i) => (
                <span class={`px-3 py-1 rounded-full font-label-md text-xs ${tagColors[i % tagColors.length]}`}>
                  {tag}
                </span>
              ))}
              {tags.length > 3 && (
                <span class="font-label-md text-xs text-on-surface-variant dark:text-inverse-on-surface/70">
                  +{tags.length - 3}
                </span>
              )}
            </div>
          )}
          <h3 class="font-headline-md text-headline-md text-on-surface dark:text-inverse-on-surface group-hover:text-primary dark:group-hover:text-inverse-primary transition-colors duration-200 mb-2 line-clamp-2">
            {title}
          </h3>
          <p class="font-body-md text-body-md text-on-surface-variant dark:text-inverse-on-surface/70 mb-5 line-clamp-3">
            {description}
          </p>
          <div class="mt-auto flex items-center text-on-surface-variant dark:text-inverse-on-surface/70 font-label-md text-sm gap-2">
            <Icon name="calendar_month" class="text-[16px]" />
            <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
          </div>
        </div>
      </div>
    </a>
  )
}

{
  variant === 'grid' && (
    <a
      href={postUrl(post.id)}
      class="group block rounded-xl bg-surface-container-lowest dark:bg-surface-dark border border-outline-variant/30 p-5 hover:-translate-y-1 hover:shadow-xl active:translate-y-0 active:scale-[0.99] active:duration-100 transition-all duration-300 flex flex-col h-full relative overflow-hidden"
    >
      <div
        class={`absolute top-0 right-0 w-16 h-16 bg-gradient-to-bl ${cardGradients[index % cardGradients.length]} rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-300`}
      />
      {tags.length > 0 && (
        <div class="flex items-center gap-2 mb-3 flex-wrap">
          {tags.slice(0, 2).map((tag, i) => (
            <span class={`px-3 py-1 rounded-full font-label-md text-xs ${tagColors[i % tagColors.length]}`}>
              {tag}
            </span>
          ))}
          {tags.length > 2 && (
            <span class="font-label-md text-xs text-on-surface-variant dark:text-inverse-on-surface/70">
              +{tags.length - 2}
            </span>
          )}
        </div>
      )}
      <h3 class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface dark:text-inverse-on-surface group-hover:text-primary dark:group-hover:text-inverse-primary transition-colors duration-200 mb-2 leading-tight line-clamp-2">
        {title}
      </h3>
      <p class="font-body-md text-body-md text-on-surface-variant dark:text-inverse-on-surface/70 mb-4 line-clamp-2 flex-grow">
        {description}
      </p>
      <div class="flex items-center text-on-surface-variant dark:text-inverse-on-surface/70 font-label-md text-xs gap-1 mt-auto pt-4 border-t border-outline-variant/20">
        <Icon name="calendar_month" class="text-[14px]" />
        <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
      </div>
    </a>
  )
}

{
  variant === 'list' && (
    <a
      href={postUrl(post.id)}
      class="group bg-surface/50 dark:bg-surface-dark/50 backdrop-blur-sm border border-outline-variant/30 rounded-xl p-6 md:p-8 flex flex-col gap-3 hover:-translate-y-1 hover:shadow-lg active:translate-y-0 active:scale-[0.99] active:duration-100 transition-all duration-300 relative overflow-hidden"
    >
      <div class="flex items-center gap-2 font-mono text-sm text-on-surface-variant/70 dark:text-inverse-on-surface/50 flex-wrap">
        <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
        {currentTag
          ? tags.length > 1 && (
              <>
                <span class="w-1 h-1 rounded-full bg-primary/30" />
                <div class="flex gap-2 flex-wrap">
                  {tags
                    .filter((t) => t !== currentTag)
                    .slice(0, 2)
                    .map((tag, i) => (
                      <span
                        class={`text-xs px-2 py-0.5 rounded-full ${tagColors[(i + index) % tagColors.length]}`}
                      >
                        {tag}
                      </span>
                    ))}
                </div>
              </>
            )
          : tags.length > 0 && (
              <>
                <span class="w-1 h-1 rounded-full bg-primary/30" />
                <div class="flex gap-2 flex-wrap">
                  {tags.map((tag, i) => (
                    <span class={`text-xs px-2 py-0.5 rounded-full ${tagColors[i % tagColors.length]}`}>
                      {tag}
                    </span>
                  ))}
                </div>
              </>
            )}
      </div>
      <h2 class="font-headline-md text-headline-md text-on-surface dark:text-inverse-on-surface group-hover:text-primary dark:group-hover:text-inverse-primary transition-colors leading-snug">
        {title}
      </h2>
      <p class="font-body-md text-body-md text-on-surface-variant dark:text-inverse-on-surface/70 line-clamp-2 max-w-3xl">
        {description}
      </p>
      <div class="mt-1 flex items-center gap-1 text-primary dark:text-inverse-primary font-label-md uppercase tracking-wider text-xs group-hover:gap-2 transition-all">
        Read Post
        <Icon name="arrow_forward" class="text-sm" />
      </div>
    </a>
  )
}
