---
import Wordmark from './Wordmark.astro';
import { footerNav, site } from '../site.config';

interface Props {
  /** Scroll reveals: the leader draws in and the columns rise (home page). */
  reveal?: boolean;
}

const { reveal = false } = Astro.props;
const year = new Date().getFullYear();
const isExternal = (href: string) => /^https?:/.test(href);
const rise = reveal ? '' : undefined;
---

<footer class="footer wrap">
  <div class="footer__plate plate" data-reveal={reveal ? 'rule' : undefined}>
    <div class="footer__bar bar" data-no="§">
      <p class="bar__title">Index</p>
      <p class="bar__meta">© {site.firstYear}–{year} {site.author}</p>
    </div>
    <div class="footer__grid">
      <div class="footer__brand" data-reveal={rise}>
        <Wordmark />
      </div>

      {
        footerNav.map((group) => (
          <nav class="footer__group" aria-label={group.title} data-reveal={rise}>
            <h2 class="label">{group.title}</h2>
            <ul role="list">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} rel={isExternal(link.href) ? 'me noopener' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="footer__colophon" data-reveal={rise}>
      Built with Astro on Cloudflare Pages. Set in Zalando Sans Expanded, Geist, and Source Serif. Every page is
      also <a href="/llms.txt">Markdown for agents</a>.
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-block: var(--section) var(--space-3);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
    padding: var(--plate-pad);
  }

  .footer__brand {
    grid-column: 1 / -1;
  }

  .footer__group ul {
    display: grid;
    margin-top: var(--space-2);
  }

  .footer__group a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--fg-2);
    text-decoration: none;
    font-size: var(--step--1);
    transition: color var(--dur-1) var(--ease);
  }

  .footer__group a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent-mark);
    text-decoration-thickness: 2px;
  }

  .footer__colophon {
    padding: var(--space-4) var(--plate-pad) var(--space-5);
    border-top: var(--hairline);
    font-size: var(--step--2);
    color: var(--fg-3);
  }

  .footer__colophon a {
    color: var(--fg-2);
  }

  /* Wide screens: each group fills columns of four links, so no group runs long */
  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr) repeat(3, auto);
      column-gap: var(--space-8);
    }

    .footer__brand {
      grid-column: auto;
    }

    .footer__group ul {
      grid-template-rows: repeat(4, auto);
      grid-auto-flow: column;
      column-gap: var(--space-6);
    }
  }
</style>
