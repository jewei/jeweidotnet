---
import Wordmark from './Wordmark.astro';
import { footerNav, site } from '../site.config';

const year = new Date().getFullYear();
const isExternal = (href: string) => /^https?:/.test(href);
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__brand">
        <Wordmark />
        <p>© {site.firstYear}–{year} {site.author}</p>
      </div>

      {
        footerNav.map((group) => (
          <nav class="footer__group" aria-label={group.title}>
            <h2 class="label">{group.title}</h2>
            <ul role="list">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} rel={isExternal(link.href) ? 'me noopener' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="footer__colophon">
      Built with Astro on Cloudflare Pages. Set in Geist and Source Serif. Every page is also{' '}
      <a href="/llms.txt">Markdown for agents</a>.
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section);
    border-top: var(--hairline);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
    padding-block: var(--space-6);
  }

  .footer__brand {
    grid-column: 1 / -1;
  }

  .footer__brand p {
    font-size: var(--step--2);
    color: var(--fg-3);
  }

  .footer__group ul {
    display: grid;
    margin-top: var(--space-2);
  }

  .footer__group a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--fg-2);
    text-decoration: none;
    font-size: var(--step--1);
    transition: color var(--dur-1) var(--ease);
  }

  .footer__group a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent-mark);
  }

  .footer__colophon {
    padding-block: var(--space-4) var(--space-6);
    border-top: var(--hairline);
    font-size: var(--step--2);
    color: var(--fg-3);
  }

  .footer__colophon a {
    color: var(--fg-2);
  }

  /* Wide screens: each group fills columns of four links, so no group runs long */
  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr) repeat(3, auto);
      column-gap: var(--space-8);
    }

    .footer__brand {
      grid-column: auto;
    }

    .footer__group ul {
      grid-template-rows: repeat(4, auto);
      grid-auto-flow: column;
      column-gap: var(--space-6);
    }
  }
</style>
