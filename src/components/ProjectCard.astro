---
/**
 * Project card for /projects/: cover, meta, name, summary, a spec list,
 * and every project link. The home page uses ProjectList instead.
 */
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  headingLevel?: 2 | 3;
  eager?: boolean;
}

const { project, headingLevel = 3, eager = false } = Astro.props;
const p = project.data;
const Heading = `h${headingLevel}` as const;
---

<article class="project plate" id={project.id}>
  <div class="project__media">
    <Image
      src={p.image}
      alt={p.imageAlt}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 64rem) 40rem, calc(100vw - 2.5rem)"
      layout="none"
      format="webp"
      quality={82}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
  </div>
  <div class="project__body">
    <p class="project__meta label">{p.category} <span aria-hidden="true">·</span> {p.status}</p>
    <Heading class="project__name">
      <a href={project.primaryUrl} data-external={!project.storyUrl || undefined}>{p.name}</a>
    </Heading>
    <p class="project__summary">{p.summary}</p>

    <dl class="project__spec">
      <div>
        <dt>Stack</dt>
        <dd>{p.stack.join(', ')}</dd>
      </div>
      {
        p.platform && (
          <div>
            <dt>Platform</dt>
            <dd>{p.platform}</dd>
          </div>
        )
      }
      <div>
        <dt>Language</dt>
        <dd>{p.language.join(', ')}</dd>
      </div>
    </dl>
    <ul class="project__links" role="list">
      {
        project.storyUrl && (
          <li>
            <a class="arrow-link" href={project.storyUrl}>
              <span>Write-up</span>
              <Icon name="arrow-right" />
            </a>
          </li>
        )
      }
      {
        p.links.map((link) => (
          <li>
            <a class="arrow-link" href={link.href} data-external>
              <span>{link.label}</span>
              <Icon name="arrow-up-right" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  /* Each project is a plate: the cover print and its spec sheet */
  .project {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    padding: var(--plate-pad);
    scroll-margin-top: var(--space-6);
  }

  .project__media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-2);
    background: var(--bg-sunken);
    outline: 1px solid var(--line);
    outline-offset: -1px;
    aspect-ratio: 16 / 10;
  }

  .project__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project:hover .project__media img {
      transform: scale(1.015);
    }
  }

  .project__meta {
    margin-bottom: var(--space-2);
  }

  .project__name {
    font-family: var(--display);
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
  }

  .project__name a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .project__name a:hover,
  .project:hover .project__name a {
    text-decoration: underline;
    text-decoration-color: var(--accent-mark);
    text-decoration-thickness: 2px;
  }

  .project__summary {
    margin-top: var(--space-2);
    color: var(--fg-2);
    max-width: 36rem;
  }

  .project__spec {
    display: grid;
    margin-top: var(--space-5);
    border-top: var(--hairline);
    font-size: var(--step--1);
  }

  .project__spec div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: var(--hairline);
  }

  .project__spec dt {
    font-family: var(--display);
    font-size: var(--step--3);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-3);
    padding-top: 0.15em;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin-top: var(--space-4);
  }

  @media (min-width: 64rem) {
    .project {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-7);
      align-items: center;
    }
  }
</style>
