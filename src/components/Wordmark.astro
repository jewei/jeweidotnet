---
/** The `jewei.toString()` wordmark. Links home. A slot before the text takes an avatar. */
---

<a href="/" class="wordmark" aria-label="jewei.toString(), home">
  <slot /><span class="wordmark__name">jewei</span><span class="wordmark__method">.toString</span><span
    class="wordmark__parens">()</span
  >
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--mono);
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--fg);
    /*
     * Each part is its own flex item, so "(" starts a line. Safari applies the
     * reset's `hanging-punctuation: first last` and hangs it over the "g".
     */
    hanging-punctuation: none;
  }

  .wordmark__name {
    font-weight: 600;
  }

  .wordmark__method {
    color: var(--fg-3);
    transition: color var(--dur-2) var(--ease);
  }

  .wordmark__parens {
    color: var(--accent);
    font-weight: 600;
  }

  .wordmark:hover .wordmark__method {
    color: var(--fg);
  }
</style>
