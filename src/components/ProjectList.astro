---
/**
 * The project grid on the home page: one cell per project, like the bays of
 * a parts drawer. Category and status on top, the cover, then name, summary,
 * and stack. The whole cell links to the visible story, or the source while
 * the story is a draft. Cells rise into view (base.css).
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../lib/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ol class="works" role="list">
  {
    projects.map(({ data: p, primaryUrl, storyUrl }) => (
      <li class="work" data-reveal>
        <p class="work__meta">
          <span>{p.category}</span>
          <span>{p.status}</span>
        </p>
        <div class="work__cover">
          <Image
            src={p.image}
            alt=""
            widths={[400, 800]}
            sizes="(min-width: 64rem) 29rem, (min-width: 40rem) 46vw, 92vw"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="work__foot">
          <div>
            <h3 class="work__name">
              <a href={primaryUrl} data-external={!storyUrl || undefined}>
                {p.name}
              </a>
            </h3>
            <p class="work__summary">{p.summary}</p>
            <p class="work__stack">{p.stack.join(' · ')}</p>
          </div>
          <span class="work__key" aria-hidden="true">
            <Icon name="arrow-right" />
          </span>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .works {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .work {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .work + .work {
    border-top: var(--hairline);
  }

  .work__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--mono);
    font-size: var(--step--3);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .work__meta span:last-child {
    text-align: right;
  }

  .work__cover {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: var(--hairline);
    border-radius: var(--radius-1);
    background: var(--bg-sunken);
  }

  .work__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform var(--dur-3) var(--ease-out);
  }

  @media (hover: hover) {
    .work:hover .work__cover img {
      transform: scale(1.03);
    }
  }

  .work__foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2rem;
    align-items: start;
    gap: var(--space-4);
    margin-top: auto;
  }

  .work__name {
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-snug);
  }

  .work__name a {
    text-decoration: none;
  }

  /* Stretch the name link over the cell */
  .work__name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .work__name a:focus-visible {
    outline: none;
  }

  .work:has(.work__name a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: -4px;
    border-radius: var(--radius-2);
  }

  .work__summary {
    margin-top: var(--space-1);
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--fg-2);
  }

  .work__stack {
    margin-top: var(--space-2);
    font-family: var(--mono);
    font-size: var(--step--2);
    color: var(--fg-3);
  }

  /* The arrow key: lights up and nudges when the cell is hovered */
  .work__key {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--fg-2);
    transition:
      background-color var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease),
      color var(--dur-2) var(--ease);
  }

  .work__key :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform var(--dur-2) var(--ease);
  }

  .work:hover .work__key {
    border-color: var(--edge);
    background: var(--signal);
    color: var(--on-signal);
  }

  .work:hover .work__key :global(svg) {
    transform: translateX(2px);
  }

  /* Two bays per row; hairlines between them, like the grid of a drawer */
  @media (min-width: 40rem) {
    .works {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work + .work {
      border-top: 0;
    }

    .work:nth-child(even) {
      border-left: var(--hairline);
    }

    .work:nth-child(n + 3) {
      border-top: var(--hairline);
    }
  }
</style>
