---
/** Topic filter links for /blog/ and /blog/<topic>/. */
import { topicName, topicUrl, type TopicKey } from '../data/topics';

interface Props {
  topics: [TopicKey, number][];
  current?: TopicKey;
  total: number;
}
const { topics, current, total } = Astro.props;
---

<nav class="topic-nav" aria-label="Topics">
  <ul role="list">
    <li>
      <a href="/blog/" aria-current={current ? undefined : 'page'}>All <span>{total}</span></a>
    </li>
    {
      topics.map(([topic, count]) => (
        <li>
          <a href={topicUrl(topic)} aria-current={topic === current ? 'page' : undefined}>
            {topicName(topic)} <span>{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .topic-nav {
    margin-block: var(--space-6);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 36px;
    padding-inline: var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-1);
    background: var(--bg-raised);
    font-family: var(--display);
    font-size: var(--step--3);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-2);
    text-decoration: none;
    transition:
      border-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease),
      transform var(--dur-1) var(--ease),
      box-shadow var(--dur-1) var(--ease);
  }

  a:hover {
    border-color: var(--fg);
    color: var(--fg);
  }

  a span {
    font-family: var(--mono);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--fg-3);
  }

  /* The current topic is lit, like the header tab */
  a[aria-current='page'] {
    border-color: var(--edge);
    background: var(--signal);
    color: var(--on-signal);
    box-shadow: 2px 2px 0 var(--edge);
  }

  a[aria-current='page'] span {
    color: var(--on-signal);
  }
</style>
