---
/**
 * The writing ledger: one row per post with number, date, title, summary,
 * and topics. The whole row is a click target; topic links stay separate.
 * The page puts the ledger on a plate.
 */
import Icon from './Icon.astro';
import { formatDate, postUrl, type Post } from '../lib/posts';
import { topicName, topicUrl, type TopicKey } from '../data/topics';

interface Props {
  posts: Post[];
  headingLevel?: 2 | 3 | 4;
  /** Hide this topic from each row (used on the topic's own page). */
  currentTopic?: TopicKey;
  showTopics?: boolean;
  /** Rows rise into view as you scroll (base.css). */
  reveal?: boolean;
  /** A round arrow key at the end of each row; it lights up on hover. */
  arrow?: boolean;
}

const { posts, headingLevel = 3, currentTopic, showTopics = true, reveal = false, arrow = true } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<ol class:list={['ledger', { 'ledger--arrow': arrow }]} role="list">
  {
    posts.map((post) => {
      const topics = post.data.tags.filter((tag) => tag !== currentTopic);
      return (
        <li class="ledger__row" data-md-post data-reveal={reveal ? '' : undefined}>
          <p class="ledger__meta">
            <span class="ledger__no">No. {post.number}</span>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate.short(post.data.pubDate)}</time>
          </p>
          <div class="ledger__body">
            <Heading class="ledger__title">
              <a href={postUrl(post)}>{post.data.title}</a>
            </Heading>
            <p class="ledger__summary">{post.data.description}</p>
            {showTopics && topics.length > 0 && (
              <ul class="ledger__topics" role="list" aria-label="Topics">
                {topics.map((topic) => (
                  <li>
                    <a href={topicUrl(topic)}>{topicName(topic)}</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
          {arrow && (
            <span class="ledger__key" aria-hidden="true">
              <Icon name="arrow-right" />
            </span>
          )}
          {post.data.draft && <span class="ledger__draft label">Draft</span>}
        </li>
      );
    })
  }
</ol>

<style>
  .ledger__row {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
  }

  .ledger__row:first-child {
    padding-top: 0;
  }

  .ledger__row:last-child {
    padding-bottom: 0;
  }

  /* The rule is a box, not a border, so a reveal can draw it (base.css) */
  .ledger__row + .ledger__row::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--line);
    transform: scaleX(var(--drawn, 1));
    transform-origin: left;
    transition: transform var(--dur-4) var(--ease-out) calc(var(--delay, 0ms) + 80ms);
  }

  .ledger__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-family: var(--mono);
    font-size: var(--step--2);
    color: var(--fg-3);
    letter-spacing: 0.02em;
  }

  /* The catalogue number is an ink tag; it lights up when the row is hovered */
  .ledger__no {
    padding: 0.15em 0.5em;
    border-radius: var(--radius-1);
    background: var(--fg);
    color: var(--bg-raised);
    font-size: var(--step--3);
    font-weight: 600;
    text-transform: uppercase;
    transition:
      background-color var(--dur-2) var(--ease),
      color var(--dur-2) var(--ease);
  }

  @media (hover: hover) {
    .ledger__row:hover .ledger__no {
      background: var(--signal);
      color: var(--on-signal);
    }
  }

  .ledger__title {
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
  }

  .ledger__title a {
    text-decoration: none;
    background-image: linear-gradient(var(--accent-mark), var(--accent-mark));
    background-size: 0 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--dur-2) var(--ease);
  }

  /* Stretch the title link over the row */
  .ledger__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .ledger__row:hover .ledger__title a,
  .ledger__title a:focus-visible {
    background-size: 100% 2px;
  }

  .ledger__title a:focus-visible {
    outline: none;
  }

  .ledger__row:has(.ledger__title a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
    border-radius: var(--radius-1);
  }

  .ledger__summary {
    margin-top: var(--space-1);
    max-width: 44rem;
    color: var(--fg-2);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  /*
   * The topics sit above the row's stretched title link. Only the topic
   * links take clicks: the gaps around them fall through to the row.
   */
  .ledger__topics {
    position: relative;
    z-index: 1;
    pointer-events: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-2);
  }

  .ledger__topics a {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    min-width: 24px;
    font-family: var(--mono);
    font-size: var(--step--2);
    color: var(--fg-3);
    text-decoration: none;
  }

  .ledger__topics a::before {
    content: '#';
    margin-right: 0.15em;
    color: var(--accent);
  }

  .ledger__topics a:hover {
    color: var(--fg);
  }

  .ledger__key {
    display: none;
  }

  .ledger__draft {
    position: absolute;
    top: var(--space-5);
    right: 0;
    color: var(--accent);
  }

  .ledger__row:first-child .ledger__draft {
    top: 0;
  }

  @media (min-width: 48rem) {
    .ledger__row {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: var(--space-6);
      padding-block: var(--space-5);
    }

    .ledger__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding-top: 0.15em;
    }

    .ledger--arrow .ledger__row {
      grid-template-columns: 8rem minmax(0, 1fr) 2rem;
    }

    /* The arrow key: a round button that lights up and nudges on hover */
    .ledger__key {
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      border: 1px solid var(--line-strong);
      border-radius: 50%;
      color: var(--fg-2);
      transition:
        background-color var(--dur-2) var(--ease),
        border-color var(--dur-2) var(--ease),
        color var(--dur-2) var(--ease);
    }

    .ledger__key :global(svg) {
      width: 0.9rem;
      height: 0.9rem;
      transition: transform var(--dur-2) var(--ease);
    }

    @media (hover: hover) {
      .ledger__row:hover .ledger__key {
        border-color: var(--edge);
        background: var(--signal);
        color: var(--on-signal);
      }

      .ledger__row:hover .ledger__key :global(svg) {
        transform: translateX(2px);
      }
    }

    .ledger--arrow .ledger__draft {
      right: var(--space-8);
    }
  }
</style>
