---
/**
 * The writing ledger: one row per post with number, date, title, summary,
 * and topics. The whole row is a click target; topic links stay separate.
 */
import Icon from './Icon.astro';
import { formatDate, postUrl, type Post } from '../lib/posts';
import { topicName, topicUrl, type TopicKey } from '../data/topics';

interface Props {
  posts: Post[];
  headingLevel?: 2 | 3 | 4;
  /** Hide this topic from each row (used on the topic's own page). */
  currentTopic?: TopicKey;
  showTopics?: boolean;
  /** Rows rise into view as you scroll (base.css). */
  reveal?: boolean;
  /** On hover, an arrow points at the post and the number turns green. */
  arrow?: boolean;
}

const { posts, headingLevel = 3, currentTopic, showTopics = true, reveal = false, arrow = false } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<ol class:list={['ledger', { 'ledger--arrow': arrow }]} role="list">
  {
    posts.map((post) => {
      const topics = post.data.tags.filter((tag) => tag !== currentTopic);
      return (
        <li class="ledger__row" data-md-post data-reveal={reveal ? '' : undefined}>
          <p class="ledger__meta">
            <span class="ledger__no">No. {post.number}</span>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate.short(post.data.pubDate)}</time>
          </p>
          <div class="ledger__body">
            <Heading class="ledger__title">
              <a href={postUrl(post)}>{post.data.title}</a>
            </Heading>
            <p class="ledger__summary">{post.data.description}</p>
            {showTopics && topics.length > 0 && (
              <ul class="ledger__topics" role="list" aria-label="Topics">
                {topics.map((topic) => (
                  <li>
                    <a href={topicUrl(topic)}>{topicName(topic)}</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
          {arrow && <Icon name="arrow-right" class="ledger__arrow" />}
          {post.data.draft && <span class="ledger__draft label">Draft</span>}
        </li>
      );
    })
  }
</ol>

<style>
  .ledger {
    border-top: var(--hairline);
  }

  .ledger__row {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
  }

  /* The rule is a box, not a border, so a reveal can draw it (base.css) */
  .ledger__row::before {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--line);
    transform: scaleX(var(--drawn, 1));
    transform-origin: left;
    transition: transform var(--dur-4) var(--ease-out) calc(var(--delay, 0ms) + 80ms);
  }

  .ledger__meta {
    display: flex;
    gap: var(--space-3);
    font-family: var(--mono);
    font-size: var(--step--2);
    color: var(--fg-3);
    letter-spacing: 0.02em;
  }

  .ledger__no {
    color: var(--fg-2);
    transition: color var(--dur-2) var(--ease);
  }

  .ledger--arrow .ledger__row:hover .ledger__no {
    color: var(--accent);
  }

  /* Icon renders the arrow, so scoped selectors need :global() */
  .ledger__row :global(.ledger__arrow) {
    display: none;
  }

  .ledger__title {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .ledger__title a {
    text-decoration: none;
    background-image: linear-gradient(var(--accent-mark), var(--accent-mark));
    background-size: 0 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--dur-2) var(--ease);
  }

  /* Stretch the title link over the row */
  .ledger__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .ledger__row:hover .ledger__title a,
  .ledger__title a:focus-visible {
    background-size: 100% 1px;
  }

  .ledger__title a:focus-visible {
    outline: none;
  }

  .ledger__row:has(.ledger__title a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
    border-radius: var(--radius-1);
  }

  .ledger__summary {
    margin-top: var(--space-1);
    max-width: 44rem;
    color: var(--fg-2);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .ledger__topics {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-2);
  }

  .ledger__topics a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    font-family: var(--mono);
    font-size: var(--step--2);
    color: var(--fg-3);
    text-decoration: none;
  }

  .ledger__topics a::before {
    content: '#';
    margin-right: 0.15em;
    color: var(--accent);
  }

  .ledger__topics a:hover {
    color: var(--fg);
  }

  .ledger__draft {
    position: absolute;
    top: var(--space-5);
    right: 0;
    color: var(--accent);
  }

  @media (min-width: 48rem) {
    .ledger__row {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: var(--space-6);
      padding-block: var(--space-6);
    }

    .ledger__meta {
      flex-direction: column;
      gap: var(--space-1);
      padding-top: 0.4em;
    }

    .ledger--arrow .ledger__row {
      grid-template-columns: 9rem minmax(0, 1fr) 1.25rem;
    }

    .ledger__row :global(.ledger__arrow) {
      display: block;
      width: 1.25rem;
      height: 1.25rem;
      margin-top: var(--space-1);
      color: var(--accent);
      opacity: 0;
      transform: translateX(calc(var(--space-2) * -1));
      transition:
        opacity var(--dur-2) var(--ease),
        transform var(--dur-2) var(--ease);
    }

    .ledger__row:hover :global(.ledger__arrow) {
      opacity: 1;
      transform: none;
    }
  }
</style>
