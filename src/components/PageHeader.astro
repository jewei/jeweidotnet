---
/** Header for index and prose pages: a signal plate with label, H1, lede, optional extras. */
interface Props {
  label?: string;
  title: string;
  lede?: string;
}
const { label, title, lede } = Astro.props;
---

<header class="page-head plate plate--signal">
  {label && <p class="label">{label}</p>}
  <h1>{title}</h1>
  {lede && <p class="page-head__lede">{lede}</p>}
  <slot />
</header>

<style>
  .page-head {
    margin-top: var(--section);
    padding: var(--space-7) var(--plate-pad) var(--plate-pad);
  }

  h1 {
    max-width: 52rem;
    font-size: var(--step-4);
  }

  .label + h1 {
    margin-top: var(--space-3);
  }

  .page-head__lede {
    margin-top: var(--space-4);
    max-width: 36rem;
    font-size: var(--step-0);
    line-height: 1.6;
  }

  @media (min-width: 64rem) {
    .page-head {
      padding-top: var(--space-8);
    }
  }
</style>
