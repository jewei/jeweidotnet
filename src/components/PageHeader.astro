---
/** Header for index and prose pages: a signal plate with label, H1, lede, optional extras. */
interface Props {
  label?: string;
  title: string;
  lede?: string;
}
const { label, title, lede } = Astro.props;
---

<header class="page-head plate plate--signal">
  {label && <p class="label">{label}</p>}
  <h1>{title}</h1>
  {lede && <p class="page-head__lede">{lede}</p>}
  <slot />
</header>

<style>
  .page-head {
    margin-top: var(--section);
    padding: var(--space-7) var(--plate-pad) var(--plate-pad);
    container-type: inline-size;
  }

  /*
   * Page titles are often one word ("Entrepreneurship"). The size follows the
   * plate, so a 16-letter word in the wide face fits on one line at 320px.
   * The floor (--step-2, in rem) keeps the title above body text when the
   * page is zoomed. If a word still cannot fit there, it breaks at a
   * syllable. Only this heading hyphenates: auto hyphenation breaks words
   * at every line end, not only words that cannot fit.
   */
  h1 {
    max-width: 52rem;
    font-size: clamp(var(--step-2), 9.5cqi, var(--step-4));
    hyphens: auto;
  }

  .label + h1 {
    margin-top: var(--space-3);
  }

  .page-head__lede {
    margin-top: var(--space-4);
    max-width: 36rem;
    font-size: var(--step-0);
    line-height: 1.6;
  }

  @media (min-width: 64rem) {
    .page-head {
      padding-top: var(--space-8);
    }
  }
</style>
