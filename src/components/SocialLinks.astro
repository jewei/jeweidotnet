---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const links = [
  {
    href: 'https://github.com/jewei',
    label: 'GitHub',
    external: true,
    path: 'M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.25c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z',
  },
  {
    href: 'https://x.com/jewei',
    label: 'X',
    external: true,
    path: 'M18.24 2.25h3.31l-7.23 8.26 8.51 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64Z',
  },
  {
    href: '/rss.xml',
    label: 'RSS',
    external: false,
    path: 'M5 3.5a15.5 15.5 0 0 1 15.5 15.5h-3A12.5 12.5 0 0 0 5 6.5v-3Zm0 6a9.5 9.5 0 0 1 9.5 9.5h-3A6.5 6.5 0 0 0 5 12.5v-3Zm2.25 6.75A2.25 2.25 0 1 1 5 18.5a2.25 2.25 0 0 1 2.25-2.25Z',
  },
];
---

<nav class:list={['social-links', compact && 'social-links--compact']} aria-label="Elsewhere">
  {
    links.map(({ href, label, external, path }) => (
      <a
        href={href}
        class="social-link"
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        aria-label={external ? `${label} (opens in new tab)` : label}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={path} />
        </svg>
        {!compact && <span>{label}</span>}
      </a>
    ))
  }
</nav>
