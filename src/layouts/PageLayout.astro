---
import BaseLayout from './BaseLayout.astro';
import { siteUrl, authorName } from '../support/site';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;

const isAboutPage = frontmatter.title === 'About Me';
const pageType = frontmatter.title === 'Contact' ? 'ContactPage' : 'WebPage';
const pageJsonLd = isAboutPage
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: authorName,
      url: `${siteUrl}/about/`,
      description: frontmatter.description,
      sameAs: ['https://github.com/jewei', 'https://x.com/jewei'],
    }
  : {
      '@context': 'https://schema.org',
      '@type': pageType,
      name: frontmatter.title,
      url: new URL(Astro.url.pathname, siteUrl).href,
      description: frontmatter.description,
      author: {
        '@type': 'Person',
        name: authorName,
        url: `${siteUrl}/about/`,
      },
    };
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(pageJsonLd)}
    slot="head"
  />

  <div class="page-document">
    <header class="page-head">
      <h1 class="page-title">
        {frontmatter.title}
      </h1>
      {
        frontmatter.description && (
          <p class="page-lede">{frontmatter.description}</p>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
