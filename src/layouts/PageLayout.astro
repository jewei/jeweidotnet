---
import BaseLayout from './BaseLayout.astro';
import { siteUrl, authorName } from '../support/site';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: authorName,
  url: `${siteUrl}/about/`,
  description: frontmatter.description,
  sameAs: ['https://github.com/jewei', 'https://x.com/jewei'],
};
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personJsonLd)}
    slot="head"
  />

  <div class="max-w-[720px] mx-auto pt-8">
    <header class="mb-10 pb-8 border-b border-outline-variant/30 relative">
      <h1
        class="font-display text-[36px] md:text-display text-on-surface dark:text-inverse-on-surface leading-tight tracking-[-0.02em] mb-3"
      >
        {frontmatter.title}
      </h1>
      {
        frontmatter.description && (
          <p class="font-body-lg text-body-lg text-on-surface-variant">{frontmatter.description}</p>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
