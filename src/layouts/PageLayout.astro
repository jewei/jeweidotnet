---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <div class="max-w-[720px] mx-auto pt-8">
    <!-- Page header -->
    <header class="mb-10 pb-8 border-b border-outline-variant/30 relative">
      <h1 class="font-display text-[36px] md:text-display text-on-surface dark:text-inverse-on-surface leading-tight tracking-[-0.02em] mb-3">
        {frontmatter.title}
      </h1>
      {frontmatter.description && (
        <p class="font-body-lg text-body-lg text-on-surface-variant">{frontmatter.description}</p>
      )}
    </header>

    <!-- Content -->
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
