---
import BaseLayout from './BaseLayout.astro';
import { siteUrl, authorName } from '../support/site';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: authorName,
  url: `${siteUrl}/about/`,
  description: frontmatter.description,
  sameAs: ['https://github.com/jewei', 'https://x.com/jewei'],
};
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personJsonLd)}
    slot="head"
  />

  <div class="page-document">
    <header class="page-head">
      <h1 class="page-title">
        {frontmatter.title}
      </h1>
      {
        frontmatter.description && (
          <p class="page-lede">{frontmatter.description}</p>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
