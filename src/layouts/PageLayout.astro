---
import BaseLayout from './BaseLayout.astro';
import { authorName, authorProfiles, personId, siteUrl } from '../support/site';
import avatar from '../assets/jewei.jpg';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    lede?: string;
  };
}

const { frontmatter } = Astro.props;

const isAboutPage = frontmatter.title === 'About Me';
const pageType = frontmatter.title === 'Contact' ? 'ContactPage' : 'WebPage';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const pageJsonLd = isAboutPage
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      '@id': personId,
      name: authorName,
      url: `${siteUrl}/about/`,
      image: new URL(avatar.src, siteUrl).href,
      jobTitle: 'Senior Software Engineer',
      description: frontmatter.description,
      knowsAbout: [
        'Backend architecture',
        'Laravel',
        'PHP',
        'Application programming interfaces',
        'Payment infrastructure',
        'Distributed systems',
        'Cloudflare',
        'Amazon Web Services',
        'AI-assisted software engineering',
      ],
      sameAs: authorProfiles,
    }
  : {
      '@context': 'https://schema.org',
      '@type': pageType,
      name: frontmatter.title,
      url: canonicalUrl,
      description: frontmatter.description,
      author: {
        '@type': 'Person',
        '@id': personId,
      },
    };
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  socialImageAlt={`${frontmatter.title} — ${frontmatter.description ?? 'a page on jewei.net'}`}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(pageJsonLd)}
    slot="head"
  />

  <div class:list={['page-document', isAboutPage && 'page-document--about']}>
    <header class="page-head">
      <h1 class="page-title">
        {frontmatter.title}
      </h1>
      {
        (frontmatter.lede ?? frontmatter.description) && (
          <p class="page-lede">{frontmatter.lede ?? frontmatter.description}</p>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
