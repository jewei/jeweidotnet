---
/**
 * The site shell: <head> metadata, header, footer, and scripts.
 * Every page renders through this layout. SEO rules live here, so pages
 * only pass data. See docs/SEO.md.
 */
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';
import { absolute, documentTitle, graph, personSchema, websiteSchema } from '../lib/seo';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';

interface Props {
  /** Page title without the site suffix. The home page passes site.homeTitle. */
  title: string;
  /** 50–160 characters. Required: every indexable page needs one. */
  description: string;
  /** Social card: an imported image, or a root path such as /og/blog.png. */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  modified?: Date;
  tags?: string[];
  /** JSON-LD nodes for this page. WebSite and Person are always added. */
  schema?: Record<string, unknown>[];
  /** Set false for pages that must not be indexed (404). */
  index?: boolean;
  /** Pass false when the page has no Markdown copy (404). */
  markdown?: boolean;
  /** Use the exact title, without the author suffix. */
  rawTitle?: boolean;
  /** Marks "Writing" active in the nav on article pages. */
  isPost?: boolean;
}

const {
  title,
  description,
  image = '/og/default.png',
  imageAlt = `${site.name}: the work and writing of ${site.author}.`,
  type = 'website',
  published,
  modified,
  tags = [],
  schema = [],
  index = true,
  markdown = true,
  rawTitle = false,
  isPost = false,
} = Astro.props;

const path = Astro.url.pathname;
const canonical = index ? absolute(path) : undefined;
const fullTitle = rawTitle ? title : documentTitle(title);
const markdownPath = path === '/' ? '/index.md' : `${path.replace(/\/$/, '')}/index.md`;

let social: { url: string; width: number; height: number };
if (typeof image === 'string') {
  social = { url: absolute(image), width: 1200, height: 630 };
} else {
  const card = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', layout: 'none' });
  social = {
    url: absolute(card.src),
    width: Number(card.attributes.width ?? 1200),
    height: Number(card.attributes.height ?? 630),
  };
}

const jsonLd = graph(websiteSchema(), personSchema(), ...schema);
const speculation = JSON.stringify({
  prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
});
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={index ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    <meta name="author" content={site.author} />

    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111317" media="(prefers-color-scheme: dark)" />
    <script is:inline src="/theme.js"></script>

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-geist-mono" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — writing by ${site.author}`} href="/rss.xml" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    <link rel="describedby" href="/llms.txt" />
    <link rel="me" href={site.profiles.github} />
    <link rel="me" href={site.profiles.x} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={social.url} />
    <meta property="og:image:width" content={String(social.width)} />
    <meta property="og:image:height" content={String(social.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={absolute('/about/')} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitter} />
    <meta name="twitter:creator" content={site.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={social.url} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline type="speculationrules" set:html={speculation} />
    <script is:inline defer src="/site.js"></script>
    {
      import.meta.env.PROD && (
        <script is:inline defer src={site.analytics.umamiSrc} data-website-id={site.analytics.umamiId} />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header isPost={isPost} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-2);
    background: var(--fg);
    color: var(--bg);
    font-weight: 500;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
