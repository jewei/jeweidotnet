---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteName = 'jewei.net';
const currentPath = Astro.url.pathname;

function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title === siteName ? siteName : `${title} — ${siteName}`}</title>
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      if ((stored ?? preferred) === 'dark') document.documentElement.classList.add('dark');
    </script>
  </head>
  <body class="bg-surface dark:bg-bg-dark text-on-surface dark:text-inverse-on-surface font-body-md antialiased overflow-x-hidden relative min-h-screen flex flex-col">

    <!-- Decorative blobs -->
    <div class="blob-bg bg-primary w-96 h-96 top-20 left-10 dark:opacity-5"></div>
    <div class="blob-bg bg-secondary w-80 h-80 top-40 right-20 dark:opacity-5" style="animation-delay: -5s;"></div>

    <!-- Header / Nav -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-surface/80 dark:bg-surface-dark/80 backdrop-blur-md border-b border-outline-variant/30">
      <nav class="max-w-[1100px] mx-auto px-6 py-4 flex justify-between items-center gap-8">

        <!-- Brand -->
        <a href="/" class="font-display text-headline-md font-bold text-primary dark:text-inverse-primary shrink-0 hover:opacity-80 transition-opacity">
          jewei.net
        </a>

        <!-- Links -->
        <ul class="hidden md:flex items-center gap-7 flex-1">
          {[
            { href: '/',        label: 'Home' },
            { href: '/blog/',   label: 'Blog' },
            { href: '/about/',  label: 'About' },
            { href: '/resume/', label: 'Résumé' },
          ].map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  'font-body-md text-body-md transition-colors duration-200',
                  isActive(href)
                    ? 'text-primary dark:text-inverse-primary font-semibold'
                    : 'text-on-surface-variant dark:text-inverse-on-surface/70 hover:text-primary dark:hover:text-inverse-primary',
                ]}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Trailing actions -->
        <div class="flex items-center gap-2">
          <a
            href="/rss.xml"
            aria-label="RSS feed"
            class="text-on-surface-variant dark:text-inverse-on-surface/70 hover:text-primary dark:hover:text-inverse-primary transition-colors p-2 rounded-full hover:bg-surface-variant/50"
          >
            <span class="material-symbols-outlined text-[20px]">rss_feed</span>
          </a>
          <button
            id="theme-toggle"
            aria-label="Toggle dark mode"
            class="text-on-surface-variant dark:text-inverse-on-surface/70 hover:text-primary dark:hover:text-inverse-primary transition-colors p-2 rounded-full hover:bg-surface-variant/50 cursor-pointer"
            onclick="
              const isDark = document.documentElement.classList.toggle('dark');
              localStorage.setItem('theme', isDark ? 'dark' : 'light');
            "
          >
            <span class="material-symbols-outlined icon-light text-[20px]">light_mode</span>
            <span class="material-symbols-outlined icon-dark text-[20px]">dark_mode</span>
          </button>
        </div>

      </nav>
    </header>

    <!-- Main content -->
    <main class="flex-grow w-full max-w-[1100px] mx-auto px-6 pt-24 pb-16 z-10 relative">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="w-full max-w-[1100px] mx-auto px-6 py-8 flex flex-col md:flex-row justify-between items-center gap-base border-t border-outline-variant/20 mt-auto z-10">
      <div class="font-display text-body-lg font-semibold text-primary dark:text-inverse-primary">jewei.net</div>
      <div class="font-body-md text-body-md text-on-surface-variant dark:text-inverse-on-surface/60">
        &copy; {new Date().getFullYear()} Jewei Mak
      </div>
      <div class="flex gap-6 font-body-md text-body-md">
        <a href="/rss.xml" class="text-on-surface-variant dark:text-inverse-on-surface/60 hover:text-primary dark:hover:text-inverse-primary transition-colors">RSS</a>
        <a href="https://github.com/jewei" class="text-on-surface-variant dark:text-inverse-on-surface/60 hover:text-primary dark:hover:text-inverse-primary transition-colors">GitHub</a>
      </div>
    </footer>

  </body>
</html>
