---
import { Font } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { siteName, pageTitle, twitterHandle, authorName } from '../support/site';
import { resolveSocialImage } from '../support/social-image';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  socialImage?: ImageMetadata;
  socialImageAlt?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  robots?: string;
  hasMarkdown?: boolean;
  canonical?: string | false;
}

const {
  title,
  description,
  socialImage,
  socialImageAlt,
  type = 'website',
  pubDate,
  updatedDate,
  robots,
  hasMarkdown = true,
  canonical,
} = Astro.props;

const canonicalSiteUrl = Astro.site!.href;
const currentPath = Astro.url.pathname;
const canonicalUrl = canonical === false
  ? undefined
  : new URL(canonical ?? currentPath, canonicalSiteUrl).href;
const cleanPath = currentPath.replace(/\/+$/, '') || '/';
const markdownPath = cleanPath === '/' ? '/index.md' : `${cleanPath}/index.md`;
const fullTitle = pageTitle(title);
const resolvedSocialImageAlt = socialImageAlt ?? 'Jewei Mak — senior software engineer, builder, and writer.';
const { url: ogImage, width: ogImageWidth, height: ogImageHeight } = await resolveSocialImage(
  socialImage,
  canonicalSiteUrl,
);

const navLinks = [
  { href: '/blog/', label: 'Writing' },
  { href: '/projects/', label: 'Projects' },
  { href: '/collections/', label: 'Collections' },
  { href: '/about/', label: 'About' },
  { href: '/resume/', label: 'Résumé' },
];

function isActive(path: string) {
  if (path === '/blog/' && type === 'article') return true;
  return currentPath.startsWith(path);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    <meta
      id="theme-color"
      name="theme-color"
      content="#f7faf6"
      data-light="#f7faf6"
      data-dark="#171b18"
    />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {hasMarkdown && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    <link rel="describedby" href="/llms.txt" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={resolvedSocialImageAlt} />
    {type === 'article' && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {type === 'article' && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={resolvedSocialImageAlt} />

    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    <slot name="head" />

    <script is:inline src="/theme.js"></script>
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="5262f0b3-3bd0-4b9f-8d21-aa555515a81d"></script>
  </head>
  <body data-page-type={type}>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="masthead">
        <div class="masthead__top">
          <a href="/" class="site-wordmark" aria-label="jewei.toString() home">jewei.toString()</a>

          <div class="masthead__actions">
            <a
              href="https://github.com/jewei"
              target="_blank"
              rel="noopener noreferrer"
              class="nav-icon-btn nav-github"
              aria-label="GitHub (opens in new tab)"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.25c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z" />
              </svg>
            </a>
            <button id="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" class="nav-icon-btn">
              <Icon name="light_mode" class="icon-light" />
              <Icon name="dark_mode" class="icon-dark" />
            </button>
            <button
              id="menu-toggle"
              type="button"
              aria-label="Open navigation menu"
              aria-controls="mobile-menu"
              aria-expanded="false"
              class="nav-icon-btn menu-toggle"
            >
              <Icon name="menu" class="icon-menu-open" />
              <Icon name="close" class="icon-menu-close hidden" />
            </button>
          </div>
        </div>

        <nav class="masthead__nav" aria-label="Main">
          <ul>
            {
              navLinks.map(({ href, label }) => (
                <li>
                  <a href={href} class:list={['nav-link', isActive(href) && 'is-active']} aria-current={isActive(href) ? 'page' : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <nav id="mobile-menu" class="mobile-nav hidden" aria-label="Mobile navigation">
        <ul class="mobile-nav__list">
          {
            navLinks.map(({ href, label }) => (
              <li>
                <a href={href} class:list={['mobile-nav__link', isActive(href) && 'is-active']} aria-current={isActive(href) ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-letter">
        <p class="footer-letter__close">Thanks for reading.<br /><span>— Jewei</span></p>
        <p class="footer-letter__postscript">Build. Write. Learn. Share.</p>
      </div>

      <div class="footer-utility">
        <nav class="footer-links" aria-label="Site information">
          <a href="/projects/">Projects</a>
          <a href="/blog/">Writing</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy/">Privacy</a>
        </nav>
        <SocialLinks compact />
        <p class="footer-credit">© 2022–{new Date().getFullYear()} {authorName}</p>
      </div>
    </footer>

    <script is:inline src="/nav.js"></script>
  </body>
</html>
