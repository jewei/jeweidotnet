---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import {
  hasCodeBlocks,
  formatTagName,
  longDateFormatter,
  postUrl,
  shortDateFormatter,
  tagToSlug,
} from '../support/blog';
import { resolveSocialImage } from '../support/social-image';
import { personId } from '../support/site';

interface Props {
  post: CollectionEntry<'blog'>;
  prev: CollectionEntry<'blog'> | null;
  next: CollectionEntry<'blog'> | null;
  related: CollectionEntry<'blog'>[];
  headings: MarkdownHeading[];
  readingTime: number;
}

const { post, prev, next, related, headings, readingTime } = Astro.props;
const { title, description, pubDate, updatedDate, tags, image, imageAlt } = post.data;
const showCodeControls = hasCodeBlocks(post.body);
const tocHeadings = headings.filter(({ depth, text }) => depth === 2 && text.trim().length > 0);
const showTableOfContents = tocHeadings.length >= 3;
const adjacentPostIds = new Set([prev?.id, next?.id].filter((id): id is string => Boolean(id)));
const continuationPosts = related.filter((relatedPost) => !adjacentPostIds.has(relatedPost.id));

const siteUrl = Astro.site!;
const postPageUrl = new URL(postUrl(post.id), siteUrl).href;
const aboutPageUrl = new URL('/about/', siteUrl).href;
const writingPageUrl = new URL('/blog/', siteUrl).href;
const socialImageMeta = image ? await resolveSocialImage(image, siteUrl.href) : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${postPageUrl}#article`,
  headline: title,
  description,
  url: postPageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postPageUrl },
  isPartOf: { '@type': 'Blog', name: 'Writing by Jewei Mak', url: writingPageUrl },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'en-US',
  timeRequired: `PT${readingTime}M`,
  keywords: tags,
  ...(tags.length > 0 ? { articleSection: tags } : {}),
  author: {
    '@type': 'Person',
    '@id': personId,
    name: 'Jewei Mak',
    url: aboutPageUrl,
  },
  publisher: {
    '@type': 'Person',
    '@id': personId,
    name: 'Jewei Mak',
    url: aboutPageUrl,
  },
  ...(socialImageMeta
    ? {
        image: {
          '@type': 'ImageObject',
          url: socialImageMeta.url,
          width: socialImageMeta.width,
          height: socialImageMeta.height,
          caption: imageAlt ?? title,
        },
      }
    : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  socialImage={image}
  socialImageAlt={imageAlt ?? `Social card for “${title}”.`}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <div class="article-shell">
    <article class="article-document">
      <header class="article-header">
        <a href="/blog/" class="article-kicker">Writing</a>

        <h1 class="article-title">{title}</h1>
        <p class="article-dek">{description}</p>

        <div class="article-byline">
          <span>
            By <a href="/about/" rel="author">Jewei Mak</a>
          </span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{longDateFormatter.format(pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
          {
            updatedDate && updatedDate > pubDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  Updated{' '}
                  <time datetime={updatedDate.toISOString()}>
                    {longDateFormatter.format(updatedDate)}
                  </time>
                </span>
              </>
            )
          }
        </div>

        {
          tags.length > 0 && (
            <nav class="article-topics" aria-label="Article topics">
              <ul>
                {tags.map((tag) => (
                  <li>
                    <a href={`/blog/${tagToSlug(tag)}/`} class="article-topic">
                      {formatTagName(tag)}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </header>

      <div class="article-content">
        {
          showTableOfContents && (
            <>
              <details class="article-toc">
                <summary class="article-toc__title">On this page</summary>
                <nav aria-label="Table of contents">
                  <ol>
                    {tocHeadings.map(({ slug, text }) => (
                      <li>
                        <a href={`#${slug}`}>{text}</a>
                      </li>
                    ))}
                  </ol>
                </nav>
              </details>

              <nav class="article-toc article-toc--rail" aria-label="Table of contents">
                <p class="article-toc__title">On this page</p>
                <ol>
                  {tocHeadings.map(({ slug, text }) => (
                    <li>
                      <a href={`#${slug}`}>{text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            </>
          )
        }

        <div class="article-body prose">
          <slot />
        </div>
      </div>

      <aside class="article-support" aria-label="Support this writing">
        <p>
          Writing takes time. If this post helped,{' '}
          <a href="https://github.com/sponsors/jewei" target="_blank" rel="noopener noreferrer">
            sponsor my work<span class="sr-only"> (opens in new tab)</span>
          </a>.
        </p>
      </aside>

      {
        (continuationPosts.length > 0 || prev || next) && (
          <section class="article-continuation" aria-labelledby="article-continuation-title">
            <div class="article-continuation__header">
              <h2 id="article-continuation-title">Continue reading</h2>
              <a href="/blog/">All writing <span aria-hidden="true">→</span></a>
            </div>

            {continuationPosts.length > 0 && (
              <ol class="related-writing__list">
                {continuationPosts.map((relatedPost) => (
                  <li>
                    <a href={postUrl(relatedPost.id)} class="related-writing__link">
                      <time datetime={relatedPost.data.pubDate.toISOString()}>
                        {shortDateFormatter.format(relatedPost.data.pubDate)}
                      </time>
                      <span class="related-writing__title">{relatedPost.data.title}</span>
                      <span class="related-writing__description">
                        {relatedPost.data.description}
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            )}

            {(prev || next) && (
              <nav class="article-pagination" aria-label="Adjacent articles">
                {prev ? (
                  <a
                    href={postUrl(prev.id)}
                    class="article-pagination__link article-pagination__link--previous"
                  >
                    <span class="article-pagination__label">
                      <span aria-hidden="true">←</span> Previous
                    </span>
                    <span class="article-pagination__title">{prev.data.title}</span>
                  </a>
                ) : (
                  <span />
                )}

                {next ? (
                  <a
                    href={postUrl(next.id)}
                    class="article-pagination__link article-pagination__link--next"
                  >
                    <span class="article-pagination__label">
                      Next <span aria-hidden="true">→</span>
                    </span>
                    <span class="article-pagination__title">{next.data.title}</span>
                  </a>
                ) : (
                  <span />
                )}
              </nav>
            )}
          </section>
        )
      }
    </article>
  </div>

  {
    showCodeControls && (
      <script is:inline src="/article.js"></script>
    )
  }
</BaseLayout>
