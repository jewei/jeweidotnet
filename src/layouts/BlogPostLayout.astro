---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { Font, Image } from 'astro:assets';
import avatar from '../assets/jewei.jpg';
import type { CollectionEntry } from 'astro:content';
import { tagColors, tagToSlug, longDateFormatter, postUrl, hasCodeBlocks } from '../support/blog';
import { resolveSocialImage } from '../support/social-image';

interface Props {
  post: CollectionEntry<'blog'>;
  prev: CollectionEntry<'blog'> | null;
  next: CollectionEntry<'blog'> | null;
  readingTime: number;
}

const { post, prev, next, readingTime } = Astro.props;
const { title, description, pubDate, updatedDate, tags, image } = post.data;
const showCodeFont = hasCodeBlocks(post.body);

const siteUrl = Astro.site!.href;
const postPageUrl = new URL(postUrl(post.id), siteUrl).href;
const socialImageMeta = image ? await resolveSocialImage(image, siteUrl) : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: postPageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postPageUrl },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Jewei Mak', url: `${siteUrl}/about/` },
  publisher: { '@type': 'Person', name: 'Jewei Mak', url: siteUrl },
  ...(socialImageMeta ? { image: socialImageMeta.url } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  socialImage={image}
  socialImageAlt={title}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  {showCodeFont && <Font cssVariable="--font-jetbrains-mono" slot="head" />}

  <div class="relative overflow-hidden">
    <div
      class="absolute top-0 right-0 w-[400px] h-[400px] bg-primary-fixed rounded-full filter blur-[100px] opacity-20 pointer-events-none -translate-y-1/2 translate-x-1/4"
    >
    </div>

    <article class="max-w-[672px] mx-auto relative z-10 pt-8">
      <div
        class="absolute -top-2 -left-14 text-surface-tint opacity-70 hidden md:block post-decoration-spin"
      >
        <svg fill="none" height="36" viewBox="0 0 40 40" width="36">
          <path
            d="M20 0C20 11.046 28.954 20 40 20C28.954 20 20 28.954 20 40C20 28.954 11.046 20 0 20C11.046 20 20 11.046 20 0Z"
            fill="currentColor"></path>
        </svg>
      </div>

      <header class="mb-10">
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          {
            tags.map((tag, i) => (
              <a
                href={`/blog/${tagToSlug(tag)}/`}
                class={`px-3 py-1 rounded-full font-label-md text-label-md uppercase tracking-wider hover:opacity-80 transition-opacity ${tagColors[i % tagColors.length]}`}
              >
                {tag}
              </a>
            ))
          }
          <div
            class="flex items-center gap-2 text-on-surface-variant dark:text-inverse-on-surface/60 font-body-md text-sm ml-auto flex-wrap"
          >
            <Icon name="calendar_today" class="text-[16px]" />
            <time datetime={pubDate.toISOString()}>{longDateFormatter.format(pubDate)}</time>
            {
              updatedDate && updatedDate > pubDate && (
                <>
                  <span class="text-outline-variant">·</span>
                  <span class="italic text-xs">
                    Updated{' '}
                    <time datetime={updatedDate.toISOString()}>
                      {longDateFormatter.format(updatedDate)}
                    </time>
                  </span>
                </>
              )
            }
            <span class="text-outline-variant">·</span>
            <Icon name="schedule" class="text-[16px]" />
            <span>{readingTime} min read</span>
          </div>
        </div>

        <h1
          class="font-display text-[32px] md:text-display text-on-surface dark:text-inverse-on-surface mb-6 leading-tight tracking-[-0.02em]"
        >
          {title}
        </h1>

        <div class="flex items-center gap-3 border-b border-outline-variant/30 pb-6">
          <div
            class="w-10 h-10 rounded-full overflow-hidden border border-outline-variant/40 bg-surface-container-highest shrink-0"
          >
            <Image
              src={avatar}
              alt="Jewei"
              class="w-full h-full object-cover"
              layout="none"
              width={40}
              height={40}
              widths={[40, 80, 120]}
              sizes="40px"
              format="webp"
              loading="lazy"
            />
          </div>
          <div>
            <p class="font-label-md text-label-md text-on-surface dark:text-inverse-on-surface">
              Jewei Mak
            </p>
            <p
              class="text-[13px] text-on-surface-variant dark:text-inverse-on-surface/60 font-body-md"
            >
              Software Engineer
            </p>
          </div>
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      <div class="flex justify-center my-12 text-primary-fixed-dim opacity-60">
        <svg class="animate-pulse" fill="none" height="24" viewBox="0 0 24 24" width="24">
          <path
            d="M12 0C12 6.627 17.373 12 24 12C17.373 12 12 17.373 12 24C12 17.373 6.627 12 0 12C6.627 12 12 6.627 12 0Z"
            fill="currentColor"></path>
        </svg>
      </div>

      <aside class="rounded-2xl border border-outline-variant/30 bg-surface-container-lowest dark:bg-surface-dark/50 px-6 py-5 mb-10 flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="text-2xl shrink-0" aria-hidden="true">♥</div>
        <div class="flex-1">
          <p class="font-label-md text-label-md text-on-surface dark:text-inverse-on-surface mb-1">
            Enjoyed this post?
          </p>
          <p class="font-body-md text-[14px] text-on-surface-variant dark:text-inverse-on-surface/70">
            Writing takes time. If this saved you a debugging session, sparked an idea, or just made the afternoon less boring — consider sponsoring my work. Even a one-time contribution means a lot.
          </p>
        </div>
        <a
          href="https://github.com/sponsors/jewei"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-primary to-surface-tint text-on-primary font-label-md text-label-md rounded-xl shadow hover:-translate-y-0.5 hover:shadow-md transition-all duration-200"
        >
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          Sponsor
        </a>
      </aside>

      {
        (prev || next) && (
          <nav class="border-t border-outline-variant/30 pt-8 mt-2 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-8">
            {prev ? (
              <a
                href={postUrl(prev.id)}
                class="group flex items-center gap-3 text-on-surface-variant dark:text-inverse-on-surface/70 hover:text-primary dark:hover:text-inverse-primary transition-colors max-w-xs"
              >
                <div class="w-10 h-10 rounded-full border border-outline-variant/30 flex items-center justify-center group-hover:border-primary group-hover:bg-primary-fixed/20 transition-all shrink-0">
                  <Icon
                    name="arrow_back"
                    class="text-[20px] group-hover:-translate-x-1 transition-transform"
                  />
                </div>
                <div>
                  <span class="block font-label-md text-label-md text-primary dark:text-inverse-primary mb-1">
                    Previous
                  </span>
                  <span class="block font-body-md text-[14px] line-clamp-2 leading-snug">
                    {prev.data.title}
                  </span>
                </div>
              </a>
            ) : (
              <div />
            )}

            {next ? (
              <a
                href={postUrl(next.id)}
                class="group flex items-center gap-3 text-on-surface-variant dark:text-inverse-on-surface/70 hover:text-primary dark:hover:text-inverse-primary transition-colors text-right sm:flex-row-reverse max-w-xs"
              >
                <div class="w-10 h-10 rounded-full border border-outline-variant/30 flex items-center justify-center group-hover:border-primary group-hover:bg-primary-fixed/20 transition-all shrink-0">
                  <Icon
                    name="arrow_forward"
                    class="text-[20px] group-hover:translate-x-1 transition-transform"
                  />
                </div>
                <div class="text-left sm:text-right">
                  <span class="block font-label-md text-label-md text-primary dark:text-inverse-primary mb-1">
                    Next
                  </span>
                  <span class="block font-body-md text-[14px] line-clamp-2 leading-snug">
                    {next.data.title}
                  </span>
                </div>
              </a>
            ) : (
              <div />
            )}
          </nav>
        )
      }
    </article>
  </div>
</BaseLayout>

<style>
  .post-decoration-spin {
    animation: spin 12s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-decoration-spin {
      animation: none;
    }
  }
</style>
