---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import TopicNav from '../../components/TopicNav.astro';
import Icon from '../../components/Icon.astro';
import { ogPath, pages } from '../../data/pages';
import { site } from '../../site.config';
import { formatDate, getPosts, groupByYear, postNumbers, postUrl, topicCounts } from '../../lib/posts';
import { absolute, breadcrumbSchema } from '../../lib/seo';

const page = pages.blog;
const posts = await getPosts();
const numbers = postNumbers(posts);
const years = groupByYear(posts);
const firstYear = years.at(-1)?.[0];

const schema = [
  {
    '@type': 'Blog',
    '@id': `${absolute('/blog/')}#blog`,
    name: `Writing by ${site.author}`,
    url: absolute('/blog/'),
    description: page.description,
    author: { '@id': `${site.url}/#person` },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      url: absolute(postUrl(post)),
      datePublished: post.data.pubDate.toISOString(),
    })),
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Writing', path: '/blog/' },
  ]),
];
---

<Base title={page.title} description={page.description} image={ogPath('blog')} schema={schema}>
  <div class="wrap">
    <PageHeader label={`${posts.length} posts since ${firstYear}`} title="Writing" lede={page.card}>
      <p class="feed">
        <a class="arrow-link" href="/rss.xml"><span>Follow by RSS</span><Icon name="rss" /></a>
      </p>
    </PageHeader>

    <TopicNav topics={topicCounts(posts)} total={posts.length} />

    {
      years.map(([year, yearPosts]) => (
        <section class="year" aria-labelledby={`y${year}`}>
          <h2 id={`y${year}`} class="year__title">
            {year}
            <span class="sr-only">, {yearPosts.length} posts</span>
          </h2>
          <PostList posts={yearPosts} numbers={numbers} />
        </section>
      ))
    }
  </div>
</Base>

<style>
  .feed {
    margin-top: var(--space-4);
  }

  .feed :global(svg) {
    width: 16px;
    height: 16px;
  }

  .year + .year {
    margin-top: var(--space-8);
  }

  .year__title {
    margin-bottom: var(--space-3);
    font-family: var(--mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--fg-3);
  }

  @media (min-width: 64rem) {
    .year {
      display: grid;
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: var(--space-6);
    }

    .year__title {
      position: sticky;
      top: var(--space-6);
      align-self: start;
      padding-top: var(--space-6);
      font-size: var(--step-2);
      font-family: var(--sans);
      font-weight: 600;
      letter-spacing: var(--tracking-heading);
      color: var(--fg);
    }
  }
</style>
