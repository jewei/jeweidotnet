---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getAllTags } from '../../support/blog';

const posts = await getPublishedPosts();
const allTags = getAllTags(posts);
---

<BaseLayout
  title="Blog"
  description="All posts by Jewei Mak — software engineering, system design, and the craft of building things."
>
  <div class="pt-8 flex flex-col gap-10">
    <header class="relative flex flex-col gap-2">
      <h1
        class="font-display text-display text-primary dark:text-inverse-primary inline-block relative z-10 leading-tight tracking-[-0.02em]"
      >
        Blog
        <svg
          class="absolute -top-3 -right-8 w-7 h-7 text-secondary/70 animate-pulse"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"></path>
        </svg>
      </h1>
      <p class="font-body-lg text-on-surface-variant dark:text-inverse-on-surface/70 max-w-3xl">
        Thoughts on software development, minimal design, and trying to build things that feel good
        to use.
      </p>
    </header>

    {
      allTags.length > 0 && (
        <section class="flex flex-wrap gap-2 items-center">
          <span class="font-label-md text-on-surface-variant dark:text-inverse-on-surface/50 uppercase tracking-widest mr-2 text-xs">
            Filter:
          </span>
          <a
            href="/blog/"
            class="px-4 py-2 rounded-full bg-primary text-on-primary font-body-md text-sm shadow-sm hover:-translate-y-0.5 transition-transform"
          >
            All
          </a>
          {allTags.map(([slug, name]) => (
            <a
              href={`/blog/${slug}/`}
              class="px-4 py-2 rounded-full bg-surface-container dark:bg-surface-dark text-on-surface dark:text-inverse-on-surface font-body-md text-sm border border-outline-variant/30 hover:bg-surface-variant dark:hover:bg-surface-dark/80 hover:-translate-y-0.5 transition-all duration-200"
            >
              {name}
            </a>
          ))}
        </section>
      )
    }

    <section class="flex flex-col gap-8">
      {posts.map((post) => (
        <PostCard post={post} variant="list" />
      ))}
    </section>
  </div>
</BaseLayout>
