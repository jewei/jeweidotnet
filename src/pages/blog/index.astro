---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getAllTags } from '../../support/blog';

const posts = await getPublishedPosts();
const allTags = getAllTags(posts);
---

<BaseLayout
  title="Blog"
  description="All posts by Jewei Mak — software engineering, system design, and the craft of building things."
>
  <div class="index-page">
    <header class="index-head">
      <h1>Blog</h1>
      <p>
        Thoughts on software development, minimal design, and trying to build things that feel good
        to use.
      </p>
    </header>

    {
      allTags.length > 0 && (
        <section class="filter-strip" aria-label="Filter posts by topic">
          <a
            href="/blog/"
            class="filter-chip is-active"
          >
            All
          </a>
          {allTags.map(([slug, name]) => (
            <a
              href={`/blog/${slug}/`}
              class="filter-chip"
            >
              {name}
            </a>
          ))}
        </section>
      )
    }

    <section class="archive-list">
      {posts.map((post) => (
        <PostCard post={post} variant="list" />
      ))}
    </section>
  </div>
</BaseLayout>
