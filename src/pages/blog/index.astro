---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import TopicNav from '../../components/TopicNav.astro';
import Icon from '../../components/Icon.astro';
import { ogPath, pages } from '../../data/pages';
import { personId, site } from '../../site.config';
import { getPosts, groupByYear, postUrl, topicCounts } from '../../lib/posts';
import { absolute, breadcrumbSchema } from '../../lib/seo';

const page = pages.blog;
const posts = await getPosts();
const years = groupByYear(posts);
const firstYear = years.at(-1)?.[0];

const schema = [
  {
    '@type': 'Blog',
    '@id': `${absolute('/blog/')}#blog`,
    name: `Writing by ${site.author}`,
    url: absolute('/blog/'),
    description: page.description,
    author: { '@id': personId },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      url: absolute(postUrl(post)),
      datePublished: post.data.pubDate.toISOString(),
    })),
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Writing', path: '/blog/' },
  ]),
];
---

<Base title={page.title} description={page.description} image={ogPath('blog')} schema={schema}>
  <div class="wrap">
    <PageHeader label={`${posts.length} posts since ${firstYear}`} title={page.title} lede={page.card}>
      <p class="feed">
        <a class="arrow-link" href="/rss.xml"><span>Follow by RSS</span><Icon name="rss" /></a>
      </p>
    </PageHeader>

    <TopicNav topics={topicCounts(posts)} total={posts.length} />

    {
      years.map(([year, yearPosts]) => (
        <section class="part" aria-labelledby={`y${year}`}>
          <header class="part__head">
            <h2 id={`y${year}`}>{year}</h2>
            <p class="bar__meta">
              {yearPosts.length} {yearPosts.length === 1 ? 'post' : 'posts'}
            </p>
          </header>
          <div class="part__body">
            <PostList posts={yearPosts} />
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .feed {
    margin-top: var(--space-4);
  }

  .feed :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
