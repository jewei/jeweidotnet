---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import { tagToSlug, getPostsByTag } from '../../support/blog';
import { siteName } from '../../support/site';

export async function getStaticPaths() {
  const tagMap = await getPostsByTag();

  return [...tagMap.entries()].map(([tagSlug, tagPosts]) => ({
    params: { tag: tagSlug },
    props: {
      tagName: tagPosts[0].data.tags.find((t) => tagToSlug(t) === tagSlug) ?? tagSlug,
      posts: tagPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { tagName, posts } = Astro.props;
---

<BaseLayout title={tagName} description={`All posts tagged "${tagName}" on ${siteName}.`}>
  <div class="pt-8">
    <a
      href="/blog/"
      class="inline-flex items-center gap-1 text-on-surface-variant dark:text-inverse-on-surface/70 hover:text-primary dark:hover:text-inverse-primary transition-colors font-body-md text-sm mb-6"
    >
      <Icon name="arrow_back" class="text-[16px]" />
      All posts
    </a>

    <header class="mb-10">
      <div class="flex items-center gap-3 mb-2">
        <span
          class="px-4 py-1.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-md text-label-md"
        >
          #{tagName}
        </span>
        <span class="text-on-surface-variant dark:text-inverse-on-surface/60 font-body-md text-sm"
          >{posts.length} post{posts.length !== 1 ? 's' : ''}</span
        >
      </div>
    </header>

    <div class="flex flex-col gap-4">
      {posts.map((post, index) => (
        <PostCard post={post} variant="list" index={index} currentTag={tagName} />
      ))}
    </div>
  </div>
</BaseLayout>
