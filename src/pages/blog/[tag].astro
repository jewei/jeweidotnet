---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatTagName, getPostsByTag, tagToSlug } from '../../support/blog';
import { siteName } from '../../support/site';

export async function getStaticPaths() {
  const tagMap = await getPostsByTag();

  return [...tagMap.entries()].map(([tagSlug, tagPosts]) => ({
    params: { tag: tagSlug },
    props: {
      tagName: tagPosts[0].data.tags.find((tag) => tagToSlug(tag) === tagSlug) ?? tagSlug,
      posts: tagPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { tagName, posts } = Astro.props;
const displayTagName = formatTagName(tagName);
---

<BaseLayout
  title={`Writing about ${displayTagName}`}
  description={`All ${posts.length} ${posts.length === 1 ? 'post' : 'posts'} about ${displayTagName} on ${siteName}.`}
  socialImageAlt={`Technical writing by Jewei Mak about ${displayTagName}.`}
>
  <div class="writing-page writing-page--tag">
    <a class="text-link writing-back-link" href="/blog/">
      <span aria-hidden="true">←</span>
      All writing
    </a>

    <header class="writing-head writing-head--tag">
      <div class="writing-head__copy">
        <h1>{displayTagName}</h1>
        <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} in this thread.</p>
      </div>
    </header>

    <section class="writing-archive" aria-labelledby="tag-archive-title">
      <h2 class="sr-only" id="tag-archive-title">Posts about {displayTagName}</h2>
      <div class="writing-list">
        {posts.map((post) => (
          <PostCard post={post} variant="list" currentTag={tagName} headingLevel={3} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
