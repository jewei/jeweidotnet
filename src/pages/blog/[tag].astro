---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import { tagToSlug, getPostsByTag } from '../../support/blog';
import { siteName } from '../../support/site';

export async function getStaticPaths() {
  const tagMap = await getPostsByTag();

  return [...tagMap.entries()].map(([tagSlug, tagPosts]) => ({
    params: { tag: tagSlug },
    props: {
      tagName: tagPosts[0].data.tags.find((t) => tagToSlug(t) === tagSlug) ?? tagSlug,
      posts: tagPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { tagName, posts } = Astro.props;
---

<BaseLayout title={tagName} description={`All posts tagged "${tagName}" on ${siteName}.`}>
  <div class="index-page">
    <a
      href="/blog/"
      class="text-link"
    >
      <Icon name="arrow_back" class="text-[16px]" />
      All posts
    </a>

    <header class="index-head index-head--tag">
      <div class="tag-summary">
        <h1>
          #{tagName}
        </h1>
        <span
          >{posts.length} post{posts.length !== 1 ? 's' : ''}</span
        >
      </div>
    </header>

    <div class="archive-list">
      {posts.map((post, index) => (
        <PostCard post={post} variant="list" index={index} currentTag={tagName} />
      ))}
    </div>
  </div>
</BaseLayout>
