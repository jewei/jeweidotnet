---
/** Topic archives at /blog/<topic>/. Topics come from src/data/topics.ts. */
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import TopicNav from '../../components/TopicNav.astro';
import { ogPath } from '../../data/pages';
import { topics, topicName } from '../../data/topics';
import { getPosts, postNumbers, postUrl, topicCounts, type Post } from '../../lib/posts';
import { absolute, breadcrumbSchema } from '../../lib/seo';
import { personId, site } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return topicCounts(posts).map(([topic]) => ({
    params: { topic },
    props: { topic, posts, tagged: posts.filter((post) => post.data.tags.includes(topic as never)) },
  }));
}

interface Props {
  topic: keyof typeof topics;
  posts: Post[];
  tagged: Post[];
}

const { topic, posts, tagged } = Astro.props;
const name = topicName(topic);
const description = topics[topic].description;
const count = `${tagged.length} ${tagged.length === 1 ? 'post' : 'posts'}`;

const schema = [
  {
    '@type': 'CollectionPage',
    name: `Writing about ${name}`,
    url: absolute(`/blog/${topic}/`),
    description,
    isPartOf: { '@id': `${absolute('/blog/')}#blog` },
    author: { '@id': personId },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: tagged.length,
      itemListElement: tagged.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: absolute(postUrl(post)),
        name: post.data.title,
      })),
    },
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Writing', path: '/blog/' },
    { name, path: `/blog/${topic}/` },
  ]),
];
---

<Base
  title={`Writing about ${name}`}
  description={description}
  image={ogPath(`topic-${topic}`)}
  imageAlt={`Writing about ${name} by ${site.author}.`}
  schema={schema}
>
  <div class="wrap">
    <PageHeader label={`Topic · ${count}`} title={name} lede={description} />
    <TopicNav topics={topicCounts(posts)} current={topic} total={posts.length} />
    <h2 class="sr-only">Posts about {name}</h2>
    <PostList posts={tagged} numbers={postNumbers(posts)} currentTopic={topic} />
  </div>
</Base>
