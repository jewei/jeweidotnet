---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import portrait from '../assets/jewei.jpg';
import { personId, site } from '../site.config';
import { ogPath, pages } from '../data/pages';
import { getPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';
import { absolute } from '../lib/seo';

const page = pages.home;
const posts = await getPosts();
const latest = posts.slice(0, 6);
const projects = (await getProjects()).filter((project) => project.data.featured).slice(0, 4);
---

<Base
  title={site.homeTitle}
  rawTitle
  description={page.description}
  image={ogPath('home')}
  imageAlt="jewei.toString(): the work and writing of software engineer Jewei Mak."
  schema={[
    {
      '@type': 'ProfilePage',
      '@id': `${absolute('/')}#page`,
      url: absolute('/'),
      name: site.homeTitle,
      mainEntity: { '@id': personId },
      primaryImageOfPage: absolute(portrait.src),
    },
  ]}
>
  <section class="intro wrap" aria-labelledby="intro-title">
    <div class="intro__copy">
      <p class="label">{site.jobTitle}</p>
      <h1 id="intro-title">
        <span>I’m {site.author}.</span>
        <span>Tastefully opinionated.</span>
      </h1>
      <div class="intro__text">
        <p>
          I love designing and building software, whether it’s something serious or just an idea I want to see work. I 
          care about both the systems behind it and the experience around it. I spend a lot of time building with AI, 
          experimenting with ideas and shipping the ones that turn into something worthwhile.
        </p>
        <p>When I’m not building software, I’m usually reading, taking photos, or trying something new in the kitchen.</p>
      </div>
      <p class="intro__status">
        <span class="intro__dot" aria-hidden="true"></span>
        <span>Open to senior roles and consulting.</span>
        <span class="intro__links">
          <a class="link" href="/resume/">Résumé</a>
          <span aria-hidden="true">·</span>
          <a class="link" href={`mailto:${site.email}`}>Email</a>
        </span>
      </p>
    </div>

    <Image
      class="intro__portrait"
      src={portrait}
      alt="Portrait of Jewei Mak."
      widths={[176, 240, 360, 480]}
      sizes="(min-width: 64rem) 12rem, 5.5rem"
      layout="none"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
  </section>

  <div class="wrap">
    <section class="part" aria-labelledby="work-title">
      <header class="part__head">
        <h2 id="work-title">Projects</h2>
        <a class="arrow-link" href="/projects/"><span>All projects</span><Icon name="arrow-right" /></a>
      </header>
      <div class="part__body">
        <ProjectList projects={projects} />
      </div>
    </section>

    <section class="part" aria-labelledby="latest-title">
      <header class="part__head">
        <h2 id="latest-title">Writing</h2>
        <a class="arrow-link" href="/blog/"><span>All {posts.length} posts</span><Icon name="arrow-right" /></a>
      </header>
      <div class="part__body">
        <PostList posts={latest} showTopics={false} />
      </div>
    </section>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8);
  }

  .intro__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  h1 {
    margin-top: var(--space-3);
    font-size: var(--step-4);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  /* One sentence per line: the name, then the stance */
  h1 span {
    display: block;
  }

  .intro__text {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
    max-width: var(--measure);
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .intro__text p + p {
    color: var(--fg-2);
  }

  .intro__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin-top: var(--space-6);
    font-size: var(--step--1);
    color: var(--fg-2);
  }

  .intro__links {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .intro__links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }

  .intro__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-mark);
    box-shadow: 0 0 0 3px var(--accent-wash);
  }

  .intro__portrait {
    order: -1;
    width: 5.5rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-2);
  }

  /* Same rail as the parts below: portrait in the rail, text in the body */
  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      gap: var(--space-6);
      padding-block: var(--space-9);
    }

    .intro__copy {
      grid-column: 2;
    }

    .intro__portrait {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
    }
  }

  /* The part rule already separates the list from the heading */
  .part__body :global(.ledger) {
    border-top: 0;
  }

  .part__body :global(.ledger__row:first-child),
  .part__body :global(.work:first-child) {
    padding-top: var(--space-2);
  }

  .part__body :global(.works) {
    border-top: 0;
  }
</style>
