---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { Image, getImage } from 'astro:assets';
import avatar from '../assets/jewei.jpg';
import { tagToSlug, getPublishedPosts, getTagCloud } from '../support/blog';
import { siteName, siteUrl, authorName } from '../support/site';

const posts = await getPublishedPosts();
const tagCloud = getTagCloud(posts);
// posts are already sorted by pubDate (newest first) in getPublishedPosts.
const pinned = posts.filter((post) => post.data.pinned);
const rest = posts.filter((post) => !post.data.pinned);

// Preload the hero avatar with a srcset that matches the <Image> below exactly,
// so the browser preloads the same candidate it will actually render (no waste).
const heroSizes = '(min-width: 768px) 240px, 176px';
const heroImage = await getImage({
  src: avatar,
  format: 'webp',
  layout: 'none',
  widths: [176, 240, 352, 480, 720],
  sizes: heroSizes,
});

const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: siteUrl,
    description: 'Personal blog by Jewei Mak — thoughts on software, systems, and the craft of building things.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: authorName,
    url: `${siteUrl}/about/`,
    sameAs: ['https://github.com/jewei', 'https://x.com/jewei'],
  },
];

---

<BaseLayout title={siteName} description="Personal blog by Jewei Mak — thoughts on software, systems, and the craft of building things.">
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset={heroImage.srcSet.attribute}
    imagesizes={heroSizes}
  />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} slot="head" />

  <!-- Hero -->
  <section class="flex flex-col-reverse md:flex-row items-center justify-between gap-10 py-12 md:py-16 relative">
    <!-- Sparkle doodles -->
    <svg class="sparkle-doodle text-primary/30 w-8 h-8 top-8 left-0" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 0l2.5 9.5L24 12l-9.5 2.5L12 24l-2.5-9.5L0 12l9.5-2.5z"/>
    </svg>
    <svg class="sparkle-doodle text-secondary/30 w-5 h-5 bottom-8 right-1/3" fill="currentColor" style="animation-delay: -2s;" viewBox="0 0 24 24">
      <path d="M12 0l1.5 10.5L24 12l-10.5 1.5L12 24l-1.5-10.5L0 12l10.5-1.5z"/>
    </svg>

    <!-- Text -->
    <div class="flex-1 space-y-4 max-w-2xl relative z-10">
      <h1 class="font-display text-display text-on-surface dark:text-inverse-on-surface leading-tight tracking-[-0.02em]">
        Hi, I'm <span class="text-primary dark:text-inverse-primary">Jewei.</span>
      </h1>
      <p class="font-headline-md text-headline-md text-on-surface-variant dark:text-inverse-on-surface/80">
        Thoughts, stories and ideas.
      </p>
      <p class="font-body-lg text-body-lg text-on-surface-variant dark:text-inverse-on-surface/70">
        I build software with the care of craft—minimal systems, deliberate details, and code I try to shape like art. Notes on what I'm learning and shipping along the way.
      </p>
      <div class="pt-2 flex gap-3 flex-wrap">
        <a
          href="/blog/"
          class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-primary to-surface-tint text-on-primary font-label-md text-label-md rounded-xl shadow-lg hover:-translate-y-1 hover:shadow-xl transition-all duration-300"
        >
          Read the Blog
        </a>
        <a
          href="/about/"
          class="inline-flex items-center justify-center px-6 py-3 border border-secondary dark:border-secondary-fixed-dim text-secondary dark:text-secondary-fixed-dim font-label-md text-label-md rounded-xl hover:-translate-y-1 hover:bg-secondary/5 transition-all duration-300"
        >
          About Me
        </a>
      </div>
    </div>

    <!-- Avatar -->
    <div class="avatar-wrapper shrink-0 relative z-10">
      <div class="avatar-float">
        <div class="avatar-glow" aria-hidden="true"></div>
        <div class="avatar-frame w-44 h-44 md:w-60 md:h-60 overflow-hidden border border-outline-variant/30 shadow-xl relative bg-surface-container-highest">
          <Image
            src={avatar}
            alt="Jewei"
            class="w-full h-full object-cover avatar-image"
            layout="none"
            widths={[176, 240, 352, 480, 720]}
            sizes={heroSizes}
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
      <div class="avatar-badge absolute -bottom-3 -right-3 bg-surface-container-lowest dark:bg-surface-dark p-2 rounded-full shadow-md border border-outline-variant/20">
        <Icon name="code" class="text-primary dark:text-inverse-primary text-2xl" />
      </div>
    </div>
  </section>

  <!-- Pinned Posts -->
  {pinned.length > 0 && (
    <section class="py-8 mt-4" id="writing">
      <div class="flex items-center gap-2 mb-5">
        <Icon name="star" class="text-primary dark:text-inverse-primary text-xl" />
        <h2 class="font-headline-lg text-headline-lg text-on-surface dark:text-inverse-on-surface">Pinned Posts</h2>
      </div>
      <div class="flex flex-col gap-6">
        {pinned.map((post) => (
          <PostCard post={post} variant="pinned" />
        ))}
      </div>
    </section>
  )}

  <!-- Remaining posts grid -->
  {rest.length > 0 && (
    <section class="py-8">
      <h2 class="font-headline-lg text-headline-lg text-on-surface dark:text-inverse-on-surface mb-6">More Writing</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {rest.map((post, index) => (
          <PostCard post={post} variant="grid" index={index} />
        ))}
      </div>
    </section>
  )}

  {posts.length === 0 && (
    <div class="py-20 text-center text-on-surface-variant dark:text-inverse-on-surface/60 font-body-md">
      No posts yet. Check back soon!
    </div>
  )}

  <!-- Tags cloud -->
  {tagCloud.length > 0 && (
    <section class="py-8 border-t border-outline-variant/20">
      <h2 class="font-headline-lg text-headline-lg text-on-surface dark:text-inverse-on-surface mb-6">Topics</h2>
      <div class="flex flex-wrap gap-3">
        {tagCloud.map(([tag, count]) => (
          <a
            href={`/blog/${tagToSlug(tag)}/`}
            class="group flex items-center gap-2 px-4 py-2 rounded-full bg-surface-container-lowest dark:bg-surface-dark border border-outline-variant/30 hover:border-primary hover:bg-primary-fixed/20 hover:-translate-y-1 transition-all duration-200"
          >
            <span class="font-body-md text-body-md text-on-surface dark:text-inverse-on-surface group-hover:text-primary dark:group-hover:text-inverse-primary transition-colors">
              {tag}
            </span>
            <span class="px-2 py-0.5 rounded-full bg-surface-variant dark:bg-surface-dark/80 text-on-surface-variant dark:text-inverse-on-surface/60 font-label-md text-[12px]">
              {count}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .avatar-wrapper {
    animation: avatar-fade-in 0.9s ease-out both;
  }

  .avatar-float {
    animation: avatar-float 6s ease-in-out infinite;
  }

  .avatar-frame {
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    animation: avatar-morph 10s ease-in-out infinite alternate;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .avatar-wrapper:hover .avatar-frame {
    transform: scale(1.04);
    box-shadow: 0 20px 40px -12px color-mix(in srgb, var(--color-primary) 25%, transparent);
  }

  .avatar-glow {
    position: absolute;
    inset: -10px;
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 40%, transparent),
      color-mix(in srgb, var(--color-secondary) 30%, transparent)
    );
    filter: blur(20px);
    opacity: 0.45;
    z-index: -1;
    animation: avatar-glow-pulse 4s ease-in-out infinite, avatar-morph 10s ease-in-out infinite alternate;
  }

  .avatar-image {
    transition: transform 0.6s ease;
  }

  .avatar-wrapper:hover .avatar-image {
    transform: scale(1.06);
  }

  .avatar-badge {
    animation: avatar-badge-wiggle 4s ease-in-out infinite;
    animation-delay: 0.6s;
  }

  @keyframes avatar-fade-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes avatar-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @keyframes avatar-morph {
    0%   { border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; }
    33%  { border-radius: 58% 42% 75% 25% / 68% 32% 68% 32%; }
    66%  { border-radius: 50% 50% 33% 67% / 55% 27% 73% 45%; }
    100% { border-radius: 33% 67% 58% 42% / 63% 68% 32% 37%; }
  }

  @keyframes avatar-glow-pulse {
    0%, 100% { opacity: 0.35; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(1.05); }
  }

  @keyframes avatar-badge-wiggle {
    0%, 100% { transform: rotate(12deg) translateY(0); }
    50% { transform: rotate(8deg) translateY(-4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-wrapper,
    .avatar-float,
    .avatar-frame,
    .avatar-glow,
    .avatar-badge {
      animation: none;
    }

    .avatar-frame,
    .avatar-image {
      transition: none;
    }
  }
</style>
