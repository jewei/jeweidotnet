---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { Image, getImage } from 'astro:assets';
import avatar from '../assets/jewei.jpg';
import { tagToSlug, getPublishedPosts, getTagCloud } from '../support/blog';
import { siteName, siteUrl, authorName } from '../support/site';

const posts = await getPublishedPosts();
// The homepage curates; /blog/ owns the full archive. Cap the grid and the
// tag cloud so the page stays a landing surface as the archive grows.
const tagCloud = getTagCloud(posts).slice(0, 12);
// posts are already sorted by pubDate (newest first) in getPublishedPosts.
const pinned = posts.filter((post) => post.data.pinned);
const latest = posts.filter((post) => !post.data.pinned).slice(0, 6);

// Preload the hero avatar with a srcset that matches the <Image> below exactly,
// so the browser preloads the same candidate it will actually render (no waste).
const heroSizes = '(min-width: 768px) 240px, 176px';
const heroImage = await getImage({
  src: avatar,
  format: 'webp',
  layout: 'none',
  widths: [176, 240, 352, 480, 720],
  sizes: heroSizes,
});

const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: siteUrl,
    description: 'jewei.toString(), the personal site of Jewei Mak, with writing about software, systems, and the craft of building things.',
    alternateName: ['jewei.net', 'Jewei Mak'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: authorName,
    alternateName: siteName,
    url: `${siteUrl}/about/`,
    sameAs: ['https://github.com/jewei', 'https://x.com/jewei'],
  },
];

---

<BaseLayout title={siteName} description="Personal blog by Jewei Mak — thoughts on software, systems, and the craft of building things.">
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset={heroImage.srcSet.attribute}
    imagesizes={heroSizes}
  />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} slot="head" />

  <!-- Ecosystem Index opening -->
  <section class="home-intro">
    <div class="home-intro__copy">
      <p class="home-status">jewei.toString() · software engineer · builder · writer</p>
      <h1 class="home-intro__title">
        Hi, I'm <span class="text-primary dark:text-inverse-primary">Jewei.</span>
      </h1>
      <p class="home-intro__lede">
        I build software with the care of craft—minimal systems, deliberate details, and code I try to shape like art. Notes on what I'm learning and shipping along the way.
      </p>
      <div class="home-actions">
        <a
          href="/blog/"
          class="tactile-btn tactile-btn--primary"
        >
          Read the Blog
        </a>
        <a
          href="/about/"
          class="tactile-btn tactile-btn--secondary"
        >
          About Me
        </a>
      </div>
    </div>

    <!-- Avatar -->
    <div class="home-portrait">
      <div class="home-portrait__frame">
          <Image
            src={avatar}
            alt="Jewei, smiling like someone whose tests just passed"
            class="home-portrait__image"
            layout="none"
            widths={[176, 240, 352, 480, 720]}
            sizes={heroSizes}
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
      </div>
      <div class="home-portrait__badge">
        <Icon name="code" class="text-primary dark:text-inverse-primary text-2xl" />
      </div>
    </div>
  </section>

  <!-- Pinned Posts -->
  {pinned.length > 0 && (
    <section class="home-rail home-rail--featured" id="writing">
      <div class="rail-heading">
        <h2>Pinned Posts</h2>
        <span>Start here</span>
      </div>
      <div class="flex flex-col gap-6">
        {pinned.map((post) => (
          <PostCard post={post} variant="pinned" />
        ))}
      </div>
    </section>
  )}

  <!-- Latest posts grid (curated; full archive lives at /blog/) -->
  {latest.length > 0 && (
    <section class="home-rail">
      <div class="rail-heading">
        <h2>Latest Writing</h2>
        <span>{latest.length} recent posts</span>
      </div>
      <div class="home-post-grid">
        {latest.map((post, index) => (
          <PostCard post={post} variant="grid" index={index} />
        ))}
      </div>
      <div class="rail-more">
        <a
          href="/blog/"
          class="text-link"
        >
          Browse all {posts.length} posts
          <Icon name="arrow_forward" class="text-[18px]" />
        </a>
      </div>
    </section>
  )}

  {posts.length === 0 && (
    <div class="py-20 text-center text-on-surface-variant dark:text-inverse-on-surface/70 font-body-md">
      <p>No posts yet — the first one is on its way.</p>
      <p class="mt-2">
        Meanwhile,{' '}<a href="/about/" class="text-secondary dark:text-secondary-fixed-dim underline underline-offset-3">read about me</a>{' '}
        or{' '}<a href="/rss.xml" class="text-secondary dark:text-secondary-fixed-dim underline underline-offset-3">subscribe to the feed</a>.
      </p>
    </div>
  )}

  <!-- Tags cloud -->
  {tagCloud.length > 0 && (
    <section class="home-rail home-topics">
      <div class="rail-heading">
        <h2>Topics</h2>
        <span>Browse a thread</span>
      </div>
      <div class="topic-list">
        {tagCloud.map(([tag, count]) => (
          <a
            href={`/blog/${tagToSlug(tag)}/`}
            class="topic-chip"
          >
            <span>
              {tag}
            </span>
            <span class="topic-count">
              {count}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Sign-off: the closing beat. Echoes the four-point star that breaks
       sections inside posts, so the page ends on the same voice it opened with. -->
  <section class="home-close">
    <p class="home-close__title">
      That's everything — for now.
    </p>
    <p>
      New posts land in the{' '}
      <a href="/rss.xml" class="text-secondary dark:text-secondary-fixed-dim underline underline-offset-3 hover:text-on-secondary-fixed dark:hover:text-secondary-fixed">RSS feed</a>{' '}
      first. Or{' '}
      <a href="https://x.com/jewei" target="_blank" rel="noopener noreferrer" class="text-secondary dark:text-secondary-fixed-dim underline underline-offset-3 hover:text-on-secondary-fixed dark:hover:text-secondary-fixed">come say hi<span class="sr-only"> (opens in new tab)</span></a>.
    </p>
  </section>

</BaseLayout>

<style>
  /* Hero copy rises in sequence, finishing as the avatar's own entrance
     settles — one choreographed load, not scattered reveals. */
  .hero-copy > * {
    animation: hero-rise 0.7s var(--ease-out-quint) both;
  }

  .hero-copy > *:nth-child(2) {
    animation-delay: 90ms;
  }

  .hero-copy > *:nth-child(3) {
    animation-delay: 180ms;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .avatar-wrapper {
    animation: none;
  }

  .avatar-float {
    animation: none;
  }

  .avatar-frame {
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    animation: none;
    transition: transform var(--dur-short) var(--ease-out);
  }

  .avatar-wrapper:hover .avatar-frame {
    transform: scale(1.04);
    box-shadow: 0 20px 40px -12px color-mix(in srgb, var(--color-primary) 25%, transparent);
  }

  .avatar-glow {
    position: absolute;
    inset: -10px;
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    background: var(--color-accent-soft);
    filter: blur(20px);
    opacity: 0.45;
    z-index: -1;
    animation: none;
  }

  .avatar-image {
    transition: transform var(--dur-short) var(--ease-out);
  }

  .avatar-wrapper:hover .avatar-image {
    transform: scale(1.06);
  }

  .avatar-badge {
    animation: none;
    animation-delay: 0.6s;
  }

  @keyframes avatar-fade-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes avatar-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @keyframes avatar-morph {
    0%   { border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; }
    33%  { border-radius: 58% 42% 75% 25% / 68% 32% 68% 32%; }
    66%  { border-radius: 50% 50% 33% 67% / 55% 27% 73% 45%; }
    100% { border-radius: 33% 67% 58% 42% / 63% 68% 32% 37%; }
  }

  @keyframes avatar-glow-pulse {
    0%, 100% { opacity: 0.35; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(1.05); }
  }

  @keyframes avatar-badge-wiggle {
    0%, 100% { transform: rotate(12deg) translateY(0); }
    50% { transform: rotate(8deg) translateY(-4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy > *,
    .avatar-wrapper,
    .avatar-float,
    .avatar-frame,
    .avatar-glow,
    .avatar-badge {
      animation: none;
    }

    .avatar-frame,
    .avatar-image {
      transition: none;
    }
  }
</style>
