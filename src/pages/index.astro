---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import portrait from '../assets/jewei.jpg';
import { personId, site } from '../site.config';
import { ogPath, pages } from '../data/pages';
import { getPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';
import { absolute } from '../lib/seo';

const page = pages.home;
const posts = await getPosts();
const latest = posts.slice(0, 6);
const allProjects = await getProjects();
const projects = allProjects.filter((project) => project.data.featured).slice(0, 4);

/*
 * The painted eyes, in the portrait's own pixels (1254 × 1254). Each eye is
 * the opening of the lids and the iris circle inside it. public/site.js
 * paints the portrait into each iris and moves it toward the pointer.
 */
const eyes = [
  {
    id: 'l',
    opening:
      'M490 553 L502 544.5 L515 537.5 L530 533.5 L545 534.5 L557.5 539.5 L565 546 L571 555 L568 557.5 L557.5 562 L545 565.5 L532.5 567 L520 565.5 L507.5 562 L497.5 557.5 Z',
    box: { x: 488, y: 530, width: 86, height: 40 },
    iris: { cx: 535.2, cy: 547, r: 20.6 },
  },
  {
    id: 'r',
    opening:
      'M703.5 549 L706 541 L715 528 L726 519.5 L740 514.5 L752.5 514 L767.5 517.5 L780 521 L790 524.5 L794 526.5 L787.5 532 L777.5 538 L765 544.5 L750 549.5 L737.5 549.5 L721 547 L709 549 Z',
    box: { x: 701, y: 511, width: 96, height: 41 },
    iris: { cx: 746.4, cy: 529, r: 20.6 },
  },
];
---

<Base
  title={site.homeTitle}
  rawTitle
  description={page.description}
  image={ogPath('home')}
  imageAlt="jewei.toString(): the work and writing of software engineer Jewei Mak."
  schema={[
    {
      '@type': 'ProfilePage',
      '@id': `${absolute('/')}#page`,
      url: absolute('/'),
      name: site.homeTitle,
      mainEntity: { '@id': personId },
      primaryImageOfPage: absolute(portrait.src),
    },
  ]}
  reveal
>
  <div class="wrap">
    <section class="intro plate" aria-labelledby="intro-title">
      <div class="intro__copy">
        <h1 id="intro-title">
          <span class="intro__line"><span>I’m <span class="intro__name">{site.author}</span>.</span></span>
          <span class="intro__line intro__line--quiet"><span>Tastefully opinionated.</span></span>
        </h1>
        <div class="intro__text">
          <p>
            I love designing and building software, whether it’s something serious or just an idea I want to see work.
            I care about both the systems behind it and the experience around it. I spend a lot of time building with
            AI, experimenting with ideas and shipping the ones that turn into something worthwhile.
          </p>
          <p>
            When I’m not building software, I’m usually reading, taking photos, or trying something new in the kitchen.
          </p>
        </div>
        <p class="intro__actions">
          <a class="button button--primary" href={`mailto:${site.email}`}>Email <Icon name="arrow-right" /></a>
          <a class="button" href="/resume/">Résumé</a>
        </p>
      </div>

      <figure class="intro__figure">
        <div class="portrait">
          <div class="intro__paper" aria-hidden="true"></div>
          <div class="portrait__disc" aria-hidden="true"></div>
          <div class="portrait__frame">
            <Image
              src={portrait}
              alt="Portrait of Jewei Mak."
              widths={[320, 480, 640]}
              sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 16rem, 13rem"
              layout="none"
              format="webp"
              quality={80}
              loading="eager"
              fetchpriority="high"
            />
            <svg class="eyes" data-eyes viewBox="0 0 1254 1254" aria-hidden="true" focusable="false">
              <defs>
                <linearGradient id="eye-white" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" class="eyes__shade"></stop>
                  <stop offset="0.45" class="eyes__mid"></stop>
                  <stop offset="1" class="eyes__lit"></stop>
                </linearGradient>
                <radialGradient id="eye-corners" cx="0.5" cy="0.6" r="0.6">
                  <stop offset="0.45" class="eyes__clear"></stop>
                  <stop offset="1" class="eyes__shade"></stop>
                </radialGradient>
                <linearGradient id="eye-lid" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" class="eyes__shade eyes__lid"></stop>
                  <stop offset="0.6" class="eyes__clear"></stop>
                </linearGradient>
                {
                  eyes.map((eye) => (
                    <>
                      <clipPath id={`eye-${eye.id}`}>
                        <path d={eye.opening} />
                      </clipPath>
                      <clipPath id={`iris-${eye.id}`}>
                        <circle cx={eye.iris.cx} cy={eye.iris.cy} r={eye.iris.r} />
                      </clipPath>
                    </>
                  ))
                }
              </defs>
              {
                eyes.map((eye) => (
                  <g clip-path={`url(#eye-${eye.id})`}>
                    <rect {...eye.box} fill="url(#eye-white)" />
                    <rect {...eye.box} fill="url(#eye-corners)" />
                    <g class="eyes__iris">
                      <image width="1254" height="1254" clip-path={`url(#iris-${eye.id})`} />
                    </g>
                    <rect {...eye.box} fill="url(#eye-lid)" />
                  </g>
                ))
              }
            </svg>
          </div>
          <p class="sticker">
            <span class="sticker__dot" aria-hidden="true"></span>
            <span>Open to senior roles and consulting.</span>
          </p>
        </div>
        <figcaption class="label intro__role">
          {site.jobTitle}
          <span class="intro__place">
            {site.city}
            <span data-clock={site.timeZone} hidden><span></span><span class="intro__colon">:</span><span></span></span>
          </span>
        </figcaption>
      </figure>
    </section>

    <section class="part" aria-labelledby="work-title" data-reveal="rule">
      <header class="part__head">
        <h2 id="work-title">Projects</h2>
        <p class="bar__meta intro__count" data-md-skip>{projects.length} of {allProjects.length}</p>
        <a class="arrow-link" href="/projects/"><span>All projects</span><Icon name="arrow-right" /></a>
      </header>
      <div class="part__body part__body--flush">
        <ProjectList projects={projects} />
      </div>
    </section>

    <section class="part" aria-labelledby="latest-title" data-reveal="rule">
      <header class="part__head">
        <h2 id="latest-title">Writing</h2>
        <a class="arrow-link" href="/blog/"><span>All {posts.length} posts</span><Icon name="arrow-right" /></a>
      </header>
      <div class="part__body">
        <PostList posts={latest} showTopics={false} reveal arrow />
      </div>
    </section>
  </div>
</Base>

<style>
  /*
   * Intro: a plate with the copy, and the portrait as a round print on a
   * signal disc. The status is a sticker slapped on the print.
   */
  .intro {
    /* The print's size; the sticker below 40rem reads it too */
    --print: 13rem;

    display: grid;
    gap: var(--space-6);
    margin-top: var(--section);
    padding: var(--space-6) var(--plate-pad) var(--plate-pad);
    overflow: clip;
    container-type: inline-size;
  }

  /*
   * Grid paper under the portrait: a dot grid that fades out from the disc.
   * It is centred on the portrait and sized in portrait percentages, so the
   * fade ends before the copy at every width. The plate clips it.
   */
  .intro__paper {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 200%;
    height: 162%;
    translate: -50% -50%;
    pointer-events: none;
    background-image: radial-gradient(circle, var(--line-strong) 1.1px, transparent 1.7px);
    background-size: var(--space-5) var(--space-5);
    background-position: center;
    /* The mask only uses alpha; any opaque token works */
    mask-image: radial-gradient(closest-side, var(--fg) 60%, transparent);
  }

  /* The copy always sits above the paper */
  .intro__copy {
    position: relative;
    z-index: 1;
  }

  .intro__figure {
    position: relative;
  }

  .intro__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    container-type: inline-size;
  }

  h1 {
    font-size: clamp(2.25rem, 11.5cqi, 4.25rem);
    line-height: 1.02;
  }

  /* One sentence per line: the name, then the stance. Each line has its own mask. */
  .intro__line {
    display: block;
    overflow: hidden;
    padding-block: 0.1em;
    margin-block: -0.1em;
  }

  .intro__line > span {
    display: block;
  }

  /*
   * The name sits on a block of signal orange, like a highlighter swipe. The
   * block is as tall as the font (the inline box): the name is ink, and ink
   * above a shorter band would vanish on the dark plate. The name never
   * breaks, so it is one box, and the entrance can clip it.
   */
  .intro__name {
    color: var(--on-signal);
    padding-inline: 0.06em;
    margin-inline: -0.02em;
    white-space: nowrap;
    background: linear-gradient(var(--signal), var(--signal)) 0 0 / 100% 100% no-repeat;
  }

  .intro__line--quiet {
    color: var(--fg-3);
  }

  .intro__text {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .intro__text p + p {
    color: var(--fg-2);
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* The portrait column. Below 40rem the sticker hangs under the print: room for it above the caption. */
  .intro__figure {
    order: -1;
    justify-self: start;
    display: grid;
    justify-items: center;
    gap: var(--space-7);
  }

  .portrait {
    position: relative;
    width: var(--print);
    aspect-ratio: 1;
  }

  .portrait__disc {
    position: absolute;
    inset: -4% -4% 4% 4%;
    border-radius: 50%;
    border: 1px solid var(--edge);
    background: var(--signal);
  }

  .portrait__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid var(--edge);
    border-radius: 50%;
    background: var(--bg-sunken);
  }

  .portrait__frame img,
  .eyes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .portrait__frame img {
    object-fit: cover;
    pointer-events: none;
  }

  /*
   * The eyes: hidden until public/site.js has painted the portrait into
   * each iris. --x and --y run from -1 to 1 toward the pointer; the iris
   * moves up to 9 portrait pixels sideways and 3.5 up or down.
   */
  .eyes {
    opacity: 0;
    pointer-events: none;
  }

  .eyes[data-on] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .eyes[data-on] {
      opacity: 0;
    }
  }

  .eyes__iris {
    transform: translate(calc(var(--x, 0) * 9px), calc(var(--y, 0) * 3.5px));
    transition: transform var(--dur-2) var(--ease-out);
  }

  .eyes__lit {
    stop-color: var(--eye-lit);
  }

  .eyes__mid {
    stop-color: var(--eye-mid);
  }

  .eyes__shade {
    stop-color: var(--eye-shade);
    stop-opacity: 0.55;
  }

  .eyes__lid {
    stop-opacity: 0.95;
  }

  .eyes__clear {
    stop-color: var(--eye-shade);
    stop-opacity: 0;
  }

  /*
   * The status sticker, slapped on the print. Below 40rem it keeps off the
   * face: it hangs from the lower-right edge, as far right as the plate
   * allows (the print sits at the left of the plate; 100cqi is the plate's
   * width), up to just over half its width past the print.
   */
  .sticker {
    position: absolute;
    bottom: -10%;
    right: max(-55%, calc(var(--print) + var(--space-2) - 100cqi));
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    max-width: 10.5rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--edge);
    border-radius: var(--radius-1);
    background: var(--bg-raised);
    box-shadow: var(--shadow-hard);
    font-family: var(--display);
    font-size: var(--step--3);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.01em;
    rotate: 5deg;
  }

  .sticker__dot {
    position: relative;
    flex: none;
    width: 7px;
    height: 7px;
    margin-top: 0.3em;
    border-radius: 50%;
    background: var(--accent-mark);
    box-shadow: 0 0 0 3px var(--accent-wash);
  }

  /* The pulse ring; it only moves with motion allowed */
  .sticker__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--accent-mark);
    opacity: 0;
  }

  /* The caption under the print: role, city, and the live time */
  .intro__role {
    position: relative;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-1);
    background: var(--bg-raised);
    font-family: var(--mono);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  /*
   * Two lines at every width: the role, then the city and its time. The
   * column under the print is too narrow for one line with a separator.
   */
  .intro__place {
    display: block;
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .intro {
      --print: 15rem;

      grid-template-columns: minmax(0, 1fr) 17rem;
      align-items: center;
      padding-top: var(--plate-pad);
    }

    .intro__figure {
      order: 0;
      justify-self: center;
      gap: var(--space-4);
    }

    .intro__paper {
      width: 140%;
      height: 227%;
    }

    .sticker {
      top: 2%;
      bottom: auto;
      right: -16%;
    }
  }

  @media (min-width: 64rem) {
    .intro {
      --print: 19rem;

      grid-template-columns: minmax(0, 1fr) 22rem;
      gap: var(--space-8);
      padding-block: var(--space-9);
    }

    .intro__paper {
      width: 156%;
      height: 210%;
    }

    .sticker {
      top: 0;
      right: -6%;
      max-width: 12rem;
      font-size: var(--step--2);
    }
  }

  /* The project grid runs to the plate's edges */
  .part__body--flush {
    padding: 0;
  }

  /* Below 30rem the bar keeps the title and the action; the count goes */
  @media (max-width: 30rem) {
    .intro__count {
      display: none;
    }
  }

  /*
   * Entrance, in order: the wordmark types itself, the nav fades in, the
   * heading lines rise out of their masks, the name wipes in on its block,
   * the text follows, and the portrait and its sticker land. Reduced motion
   * skips all of it. Nothing here changes layout: the wordmark types by
   * clipping (its width never changes, so the nav never moves), and the name
   * and its block wipe in together (no ink name on the dark plate).
   */
  @media (prefers-reduced-motion: no-preference) {
    :global(.header .wordmark > span) {
      animation: home-type calc(var(--chars) * var(--per)) steps(var(--chars)) var(--start) backwards;
    }

    :global(.header .wordmark__name) {
      --chars: 5;
      --per: 62ms;
      --start: 120ms;
    }

    :global(.header .wordmark__method) {
      --chars: 9;
      --per: 40ms;
      --start: 430ms;
    }

    :global(.header .wordmark__parens) {
      --chars: 2;
      --per: 80ms;
      --start: 790ms;
    }

    /* When the wordmark is typed, a caret blinks twice at its end, and goes. It takes no width. */
    :global(.header .wordmark::after) {
      content: '';
      width: 2px;
      height: 1.1em;
      margin-inline: 2px -4px;
      background: var(--accent-mark);
      opacity: 0;
      animation: home-caret 1060ms steps(1, end) 1190ms 2;
    }

    :global(.header__nav li),
    :global(.header__theme) {
      animation: home-fade 900ms var(--ease) 260ms backwards;
    }

    :global(.header__nav li:nth-child(2)) {
      animation-delay: 310ms;
    }

    :global(.header__nav li:nth-child(3)) {
      animation-delay: 360ms;
    }

    :global(.header__nav li:nth-child(4)) {
      animation-delay: 410ms;
    }

    :global(.header__theme) {
      animation-delay: 460ms;
    }

    .intro__line > span {
      animation: home-line var(--dur-4) var(--ease-out) 260ms backwards;
    }

    .intro__line--quiet > span {
      animation-delay: 350ms;
    }

    .intro__name {
      animation: home-wipe var(--dur-3) var(--ease-out) 450ms backwards;
    }

    .intro__text p {
      animation: home-rise var(--dur-3) var(--ease) 520ms backwards;
    }

    .intro__text p + p {
      animation-delay: 600ms;
    }

    .intro__actions {
      animation: home-rise var(--dur-3) var(--ease) 700ms backwards;
    }

    .intro__paper {
      animation: home-fade 900ms var(--ease) 600ms backwards;
    }

    .portrait__disc {
      animation: home-grow var(--dur-3) var(--ease-spring) 380ms backwards;
    }

    .portrait__frame {
      animation: home-rise var(--dur-3) var(--ease) 480ms backwards;
    }

    .intro__role {
      animation: home-fade 900ms var(--ease) 760ms backwards;
    }

    .sticker {
      animation: home-slap var(--dur-3) var(--ease-spring) 1000ms backwards;
    }

    .sticker__dot::after {
      animation: home-pulse 2600ms cubic-bezier(0, 0.55, 0.45, 1) 1900ms infinite;
    }

    .intro__colon {
      animation: home-blink 2000ms steps(1, end) infinite;
    }
  }

  /*
   * One step per character (the wordmark is monospaced). Both ends are
   * inset(): inset() and none do not interpolate.
   */
  @keyframes home-type {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0);
    }
  }

  @keyframes home-caret {
    from {
      opacity: 1;
    }

    50% {
      opacity: 0;
    }
  }

  @keyframes home-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(var(--space-4));
    }
  }

  @keyframes home-line {
    from {
      transform: translateY(108%);
    }
  }

  /* The name and its highlighter block wipe in together from the left */
  @keyframes home-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0);
    }
  }

  @keyframes home-grow {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  /* Starts small enough that every frame stays inside the viewport */
  @keyframes home-slap {
    from {
      opacity: 0;
      transform: scale(1.25) rotate(-6deg);
    }
  }

  @keyframes home-pulse {
    from {
      opacity: 0.55;
      transform: scale(1);
    }

    to {
      opacity: 0;
      transform: scale(3.6);
    }
  }

  @keyframes home-blink {
    50% {
      opacity: 0.2;
    }
  }
</style>
