---
import { Image, getImage } from 'astro:assets';
import avatar from '../assets/jewei.jpg';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { formatTagName, getPublishedPosts, getTagCloud, tagToSlug } from '../support/blog';
import {
  authorName,
  authorProfiles,
  personId,
  siteDescription,
  siteName,
  siteUrl,
} from '../support/site';

const posts = await getPublishedPosts();
const selectedProjects = projects.slice(0, 4);
const pinned = posts.filter((post) => post.data.pinned);
const latest = posts.filter((post) => !post.data.pinned).slice(0, 6);
const tagCloud = getTagCloud(posts).slice(0, 12);

const heroSizes = '(min-width: 1200px) 23rem, (min-width: 960px) calc((100vw - 11rem) * 5 / 12 - 1rem), 7rem';
const heroImage = await getImage({
  src: avatar,
  format: 'webp',
  layout: 'none',
  widths: [240, 320, 400, 480, 640],
  sizes: heroSizes,
});

const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    alternateName: ['jewei.net', authorName],
    url: siteUrl,
    description: siteDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: authorName,
    alternateName: siteName,
    jobTitle: 'Senior Software Engineer',
    url: `${siteUrl}/about/`,
    image: new URL(avatar.src, siteUrl).href,
    sameAs: authorProfiles,
    knowsAbout: [
      'Backend architecture',
      'Application programming interfaces',
      'Laravel',
      'PHP',
      'Payment infrastructure',
      'Distributed systems',
      'Cloud infrastructure',
      'AI-assisted software engineering',
    ],
  },
];
---

<BaseLayout
  title={siteName}
  description={siteDescription}
  socialImageAlt="jewei.toString(), the personal site of software engineer Jewei Mak."
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset={heroImage.srcSet.attribute}
    imagesizes={heroSizes}
    fetchpriority="high"
  />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} slot="head" />

  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="home-hero__identity">
        Senior software engineer · backend architect
      </p>
      <h1 class="home-hero__title" id="home-title">
        <span class="home-hero__greeting">Hi, I’m</span>{' '}
        <span class="home-hero__title-name">Jewei<span class="home-hero__period">.</span></span>
      </h1>
      <p class="home-hero__statement">
        I build reliable software and useful tools. I write about what I learn.
      </p>
      <p class="home-hero__detail">
        Backend systems, product architecture, developer experience, and
        AI-assisted engineering.
      </p>
      <div class="home-hero__actions">
        <a class="button-link button-link--primary" href="/projects/">Explore my work</a>
        <a class="text-link" href="/blog/">
          Read my writing
          <span aria-hidden="true">→</span>
        </a>
        <a class="text-link text-link--quiet" href="/resume/">
          Résumé
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="home-hero__portrait">
      <div class="home-hero__portrait-frame">
        <Image
          src={avatar}
          alt="Portrait of Jewei Mak."
          class="home-hero__portrait-image"
          layout="none"
          widths={[240, 320, 400, 480, 640]}
          sizes={heroSizes}
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        <span>jewei.toString()</span>
        <a class="text-link text-link--quiet" href="/about/">
          About me <span aria-hidden="true">→</span>
        </a>
      </figcaption>
    </figure>
  </section>

  <section class="home-section" id="selected-work" aria-labelledby="selected-work-title">
    <SectionHeader
      id="selected-work-title"
      title="Selected Work"
      description="Tools and libraries for problems that kept asking to be solved."
      actionHref="/projects/"
      actionLabel="View all projects"
    />
    <div class="project-grid project-grid--selected">
      {selectedProjects.map((project) => (
        <ProjectCard project={project} variant="selected" headingLevel={3} />
      ))}
    </div>
  </section>

  <section class="home-section home-proof" aria-labelledby="professional-depth-title">
    <SectionHeader
      id="professional-depth-title"
      title="Experience at scale"
      description="A compact record of the systems behind the work."
      actionHref="/resume/"
      actionLabel="View résumé"
    />
    <dl class="proof-strip">
      <div class="proof-strip__item">
        <dt>15+</dt>
        <dd>years building software</dd>
      </div>
      <div class="proof-strip__item">
        <dt>1M+</dt>
        <dd>users served</dd>
      </div>
      <div class="proof-strip__item">
        <dt>50K+</dt>
        <dd>monthly transactions supported</dd>
      </div>
      <div class="proof-strip__item">
        <dt>10+</dt>
        <dd>payment providers integrated</dd>
      </div>
    </dl>
    <p class="proof-strip__scope">Backend systems · APIs · payment infrastructure</p>
  </section>

  {pinned.length > 0 && (
    <section class="home-section" aria-labelledby="pinned-posts-title">
      <SectionHeader
        id="pinned-posts-title"
        title="Pinned Posts"
        description="A good place to start."
      />
      <div class="writing-list">
        {pinned.map((post) => <PostCard post={post} variant="list" headingLevel={3} />)}
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section id="writing" class="home-section" aria-labelledby="latest-writing-title">
      <SectionHeader
        id="latest-writing-title"
        title="Latest Writing"
        description="Recent notes on software, systems, and making things."
        actionHref="/blog/"
        actionLabel={`Browse all ${posts.length} posts`}
      />
      <div class="writing-list">
        {latest.map((post) => <PostCard post={post} variant="list" headingLevel={3} />)}
      </div>
      <p class="home-writing-follow">
        New posts land in the <a class="text-link" href="/rss.xml">RSS feed</a> first. You can also{' '}
        <a class="text-link" href="/contact/">say hello</a>.
      </p>
    </section>
  )}

  {posts.length === 0 && (
    <section class="home-empty" aria-labelledby="home-empty-title">
      <h2 id="home-empty-title">The first post is on its way.</h2>
      <p>
        Meanwhile, <a class="text-link" href="/about/">read about me</a> or
        <a class="text-link" href="/rss.xml">subscribe to the feed</a>.
      </p>
    </section>
  )}

  {tagCloud.length > 0 && (
    <section class="home-section" aria-labelledby="topics-title">
      <SectionHeader
        id="topics-title"
        title="Topics"
        description="Threads through the working notebook."
      />
      <nav class="topic-index" aria-label="Browse writing by topic">
        {tagCloud.map(([tag, count]) => (
          <a class="topic-index__link" href={`/blog/${tagToSlug(tag)}/`}>
            <span>{formatTagName(tag)}</span>
            <span class="topic-index__count">
              {count} {count === 1 ? 'post' : 'posts'}
            </span>
          </a>
        ))}
      </nav>
    </section>
  )}

</BaseLayout>
