---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Build tag counts for the cloud
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tagCloud = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const [featured, ...rest] = posts;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const tagColors = [
  'bg-primary-fixed text-on-primary-fixed',
  'bg-secondary-fixed text-on-secondary-fixed',
  'bg-tertiary-fixed text-on-tertiary-fixed',
  'bg-surface-variant text-on-surface-variant',
];

const cardGradients = [
  'from-primary/10 via-surface-container to-surface-container-lowest',
  'from-secondary/10 via-surface-container to-surface-container-lowest',
  'from-tertiary/10 via-surface-container to-surface-container-lowest',
];
---

<BaseLayout title="jewei.net" description="Personal blog by Jewei Mak — thoughts on software, systems, and the craft of building things.">

  <!-- Hero -->
  <section class="flex flex-col-reverse md:flex-row items-center justify-between gap-10 py-12 md:py-16 relative">
    <!-- Sparkle doodles -->
    <svg class="sparkle-doodle text-primary/30 w-8 h-8 top-8 left-0" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 0l2.5 9.5L24 12l-9.5 2.5L12 24l-2.5-9.5L0 12l9.5-2.5z"/>
    </svg>
    <svg class="sparkle-doodle text-secondary/30 w-5 h-5 bottom-8 right-1/3" fill="currentColor" style="animation-delay: -2s;" viewBox="0 0 24 24">
      <path d="M12 0l1.5 10.5L24 12l-10.5 1.5L12 24l-1.5-10.5L0 12l10.5-1.5z"/>
    </svg>

    <!-- Text -->
    <div class="flex-1 space-y-4 max-w-2xl relative z-10">
      <h1 class="font-display text-display text-on-surface dark:text-inverse-on-surface leading-tight tracking-[-0.02em]">
        Hi, I'm <span class="text-primary dark:text-inverse-primary">Jewei.</span>
      </h1>
      <p class="font-headline-md text-headline-md text-on-surface-variant dark:text-inverse-on-surface/80">
        Thoughts, stories and ideas.
      </p>
      <p class="font-body-lg text-body-lg text-on-surface-variant dark:text-inverse-on-surface/70">
        A developer building polished corners of the internet. Welcome to my personal space where I share what I'm learning and building.
      </p>
      <div class="pt-2 flex gap-3 flex-wrap">
        <a
          href="/blog/"
          class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-primary to-surface-tint text-on-primary font-label-md text-label-md rounded-xl shadow-lg hover:-translate-y-1 hover:shadow-xl transition-all duration-300"
        >
          Read the Blog
        </a>
        <a
          href="/about/"
          class="inline-flex items-center justify-center px-6 py-3 border border-secondary dark:border-secondary-fixed-dim text-secondary dark:text-secondary-fixed-dim font-label-md text-label-md rounded-xl hover:-translate-y-1 hover:bg-secondary/5 transition-all duration-300"
        >
          About Me
        </a>
      </div>
    </div>

    <!-- Avatar -->
    <div class="shrink-0 relative z-10">
      <div class="w-44 h-44 md:w-60 md:h-60 rounded-[30%_70%_70%_30%/30%_30%_70%_70%] overflow-hidden border border-outline-variant/30 shadow-xl relative bg-surface-container-highest">
        <img
          src="/content/images/2024/09/IMG_0362-1.jpg"
          alt="Jewei"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="absolute -bottom-3 -right-3 bg-surface-container-lowest dark:bg-surface-dark p-2 rounded-full shadow-md border border-outline-variant/20 rotate-12">
        <span class="material-symbols-outlined text-primary dark:text-inverse-primary text-2xl" style="font-variation-settings: 'FILL' 1;">code</span>
      </div>
    </div>
  </section>

  <!-- Featured Post -->
  {featured && (
    <section class="py-8 mt-4" id="writing">
      <div class="flex items-center gap-2 mb-5">
        <span class="material-symbols-outlined text-primary dark:text-inverse-primary text-xl" style="font-variation-settings: 'FILL' 1;">star</span>
        <h2 class="font-headline-lg text-headline-lg text-on-surface dark:text-inverse-on-surface">Latest Post</h2>
      </div>
      <a
        href={`/${featured.id.replace(/\.mdx?$/, '')}/`}
        class="group block relative overflow-hidden rounded-xl bg-surface-container-lowest dark:bg-surface-dark border border-outline-variant/30 hover:-translate-y-1 hover:shadow-xl transition-all duration-300"
      >
        <div class="flex flex-col md:flex-row h-full">
          <!-- Thumbnail: featured image or gradient fallback -->
          <div class="md:w-2/5 h-48 md:h-auto relative overflow-hidden flex-shrink-0">
            {featured.data.image ? (
              <img
                src={featured.data.image}
                alt={featured.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            ) : (
              <>
                <div class="absolute inset-0 bg-gradient-to-br from-primary/20 via-secondary/10 to-tertiary/10"></div>
                <div class="absolute inset-0 bg-gradient-to-tr from-primary/30 to-secondary/20 group-hover:scale-105 transition-transform duration-500"></div>
                <svg class="absolute inset-0 m-auto w-16 h-16 text-primary/20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0l2.5 9.5L24 12l-9.5 2.5L12 24l-2.5-9.5L0 12l9.5-2.5z"/>
                </svg>
              </>
            )}
          </div>
          <div class="flex-1 p-6 md:p-8 flex flex-col justify-center">
            {featured.data.tags.length > 0 && (
              <div class="flex gap-2 mb-4 flex-wrap">
                {featured.data.tags.slice(0, 3).map((tag, i) => (
                  <span class={`px-3 py-1 rounded-full font-label-md text-xs ${tagColors[i % tagColors.length]}`}>
                    {tag}
                  </span>
                ))}
              </div>
            )}
            <h3 class="font-headline-md text-headline-md text-on-surface dark:text-inverse-on-surface group-hover:text-primary dark:group-hover:text-inverse-primary transition-colors duration-200 mb-2">
              {featured.data.title}
            </h3>
            {featured.data.description && (
              <p class="font-body-md text-body-md text-on-surface-variant dark:text-inverse-on-surface/70 mb-5 line-clamp-3">
                {featured.data.description}
              </p>
            )}
            <div class="mt-auto flex items-center text-on-surface-variant dark:text-inverse-on-surface/60 font-label-md text-sm gap-2">
              <span class="material-symbols-outlined text-[16px]">calendar_month</span>
              <time datetime={featured.data.pubDate.toISOString()}>
                {dateFormatter.format(featured.data.pubDate)}
              </time>
            </div>
          </div>
        </div>
      </a>
    </section>
  )}

  <!-- Remaining posts grid -->
  {rest.length > 0 && (
    <section class="py-8">
      <h2 class="font-headline-lg text-headline-lg text-on-surface dark:text-inverse-on-surface mb-6">More Writing</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {rest.map((post, index) => (
          <a
            href={`/${post.id.replace(/\.mdx?$/, '')}/`}
            class="group block rounded-xl bg-surface-container-lowest dark:bg-surface-dark border border-outline-variant/30 p-5 hover:-translate-y-1 hover:shadow-xl transition-all duration-300 flex flex-col h-full relative overflow-hidden"
          >
            <!-- Corner gradient on hover -->
            <div class={`absolute top-0 right-0 w-16 h-16 bg-gradient-to-bl ${cardGradients[index % cardGradients.length]} rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-300`}></div>

            {post.data.tags.length > 0 && (
              <div class="flex gap-2 mb-3 flex-wrap">
                {post.data.tags.slice(0, 2).map((tag, i) => (
                  <span class={`px-2 py-1 rounded-md font-label-md text-xs ${tagColors[i % tagColors.length]}`}>
                    {tag}
                  </span>
                ))}
              </div>
            )}

            <h3 class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface dark:text-inverse-on-surface group-hover:text-primary dark:group-hover:text-inverse-primary transition-colors duration-200 mb-2 leading-tight">
              {post.data.title}
            </h3>

            {post.data.description && (
              <p class="font-body-md text-body-md text-on-surface-variant dark:text-inverse-on-surface/70 mb-4 line-clamp-2 flex-grow">
                {post.data.description}
              </p>
            )}

            <div class="flex items-center text-on-surface-variant dark:text-inverse-on-surface/60 font-label-md text-xs gap-1 mt-auto pt-4 border-t border-outline-variant/20">
              <span class="material-symbols-outlined text-[14px]">schedule</span>
              <time datetime={post.data.pubDate.toISOString()}>
                {dateFormatter.format(post.data.pubDate)}
              </time>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {posts.length === 0 && (
    <div class="py-20 text-center text-on-surface-variant dark:text-inverse-on-surface/60 font-body-md">
      No posts yet. Check back soon!
    </div>
  )}

  <!-- Tags cloud -->
  {tagCloud.length > 0 && (
    <section class="py-8 border-t border-outline-variant/20">
      <h2 class="font-headline-lg text-headline-lg text-on-surface dark:text-inverse-on-surface mb-6">Topics</h2>
      <div class="flex flex-wrap gap-3">
        {tagCloud.map(([tag, count]) => (
          <a
            href={`/blog/${tag.toLowerCase().replace(/\s+/g, '-')}/`}
            class="group flex items-center gap-2 px-4 py-2 rounded-full bg-surface-container-lowest dark:bg-surface-dark border border-outline-variant/30 hover:border-primary hover:bg-primary-fixed/20 hover:-translate-y-1 transition-all duration-200"
          >
            <span class="font-body-md text-body-md text-on-surface dark:text-inverse-on-surface group-hover:text-primary dark:group-hover:text-inverse-primary transition-colors">
              {tag}
            </span>
            <span class="px-2 py-0.5 rounded-full bg-surface-variant dark:bg-surface-dark/80 text-on-surface-variant dark:text-inverse-on-surface/60 font-label-md text-[12px]">
              {count}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

</BaseLayout>
