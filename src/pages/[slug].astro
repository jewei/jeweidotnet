---
/**
 * Article pages at /<slug>/. One per published post in src/content/blog/.
 */
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/jewei.jpg';
import { personId, site } from '../site.config';
import { ogPath } from '../data/pages';
import { topicName, topicUrl } from '../data/topics';
import {
  formatDate,
  getPosts,
  lastModified,
  postSlug,
  postUrl,
  readingMinutes,
  relatedPosts,
} from '../lib/posts';
import { absolute, breadcrumbSchema } from '../lib/seo';
import { ogImage } from '../lib/og';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      newer: posts[index - 1] ?? null,
      older: posts[index + 1] ?? null,
      related: relatedPosts(post, posts),
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, newer, older, related } = Astro.props;
const { title, description, pubDate, updatedDate, tags, image, imageAlt } = post.data;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post.body);
const toc = headings.filter((heading) => heading.depth === 2);
const showToc = toc.length >= 3;
const url = absolute(postUrl(post));
const primaryTopic = tags[0];
const adjacent = new Set([newer?.id, older?.id]);
const more = related.filter((candidate) => !adjacent.has(candidate.id));

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    datePublished: pubDate.toISOString(),
    dateModified: lastModified(post).toISOString(),
    inLanguage: 'en',
    wordCount: post.body?.split(/\s+/).length,
    timeRequired: `PT${minutes}M`,
    keywords: tags.map(topicName),
    articleSection: topicName(primaryTopic),
    author: { '@id': personId },
    publisher: { '@id': personId },
    image: absolute(image ? image.src : await ogImage(`post-${postSlug(post)}`)),
    isPartOf: { '@type': 'Blog', '@id': `${absolute('/blog/')}#blog`, name: `Writing by ${site.author}` },
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Writing', path: '/blog/' },
    { name: topicName(primaryTopic), path: topicUrl(primaryTopic) },
    { name: title, path: postUrl(post) },
  ]),
];
---

<Base
  title={title}
  description={description}
  image={image ?? ogPath(`post-${postSlug(post)}`)}
  imageAlt={imageAlt ?? `${title}, an article by ${site.author}.`}
  article={{ published: pubDate, modified: updatedDate, tags: tags.map(topicName) }}
  schema={schema}
  serif
>
  <div class="progress" aria-hidden="true"></div>

  <div class="wrap">
    <article class="article plate" data-has-toc={showToc || undefined}>
      <header class="article__head plate--signal">
        <nav class="crumbs label" aria-label="Breadcrumb" data-md-skip>
          <ol role="list">
            <li><a href="/blog/">Writing</a></li>
            <li><a href={topicUrl(primaryTopic)}>{topicName(primaryTopic)}</a></li>
          </ol>
        </nav>
        <h1 class="article__title">{title}</h1>
        <p class="article__dek">{description}</p>
        <div class="byline">
          <Image src={portrait} alt="" width={36} height={36} format="webp" layout="fixed" />
          <p>
            <span>By <a href="/about/" rel="author">{site.author}</a></span>
            <span class="byline__meta">
              <time datetime={pubDate.toISOString()}>{formatDate.long(pubDate)}</time>
              <span>· {minutes} min read</span>
            </span>
          </p>
        </div>
      </header>

      <aside class="article__rail" aria-label="Article details">
        <dl class="facts">
          <div>
            <dt>Entry</dt>
            <dd>No. {post.number}</dd>
          </div>
          <div>
            <dt>Published</dt>
            <dd><time datetime={pubDate.toISOString()}>{formatDate.short(pubDate)}</time></dd>
          </div>
          {
            updatedDate && updatedDate > pubDate && (
              <div>
                <dt>Updated</dt>
                <dd>
                  <time datetime={updatedDate.toISOString()}>{formatDate.short(updatedDate)}</time>
                </dd>
              </div>
            )
          }
          <div>
            <dt>Topics</dt>
            <dd>
              <ul role="list">
                {
                  tags.map((tag) => (
                    <li>
                      <a href={topicUrl(tag)}>{topicName(tag)}</a>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
        </dl>

        {
          showToc && (
            <nav class="toc" aria-labelledby="toc-title" data-md-skip>
              <h2 id="toc-title" class="label">
                On this page
              </h2>
              <ol role="list">
                {toc.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>

      <div class="article__body prose">
        <Content />
      </div>

      <footer class="article__foot">
        <section class="author" aria-labelledby="author-title">
          <Image src={portrait} alt="" width={72} height={72} format="webp" layout="fixed" />
          <div>
            <h2 id="author-title" class="author__name">Written by {site.author}</h2>
            <p>
              Senior software engineer, working on backend systems and payments. New posts go to the
              <a class="link" href="/rss.xml">RSS feed</a>. If this one saved you time, you can
              <a class="link" href={site.profiles.sponsor}>sponsor the work</a>.
            </p>
          </div>
        </section>
      </footer>
    </article>

    <section class="continue part" aria-labelledby="continue-title">
      <header class="part__head">
        <h2 id="continue-title">Keep reading</h2>
        <a class="arrow-link" href="/blog/"><span>All writing</span><Icon name="arrow-right" /></a>
      </header>
      <div class="part__body">
        <nav class="pager" aria-label="Newer and older posts">
          {
            older ? (
              <a class="pager__link" href={postUrl(older)} rel="prev">
                <span class="label">
                  <Icon name="arrow-left" /> Older
                </span>
                <span class="pager__title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a class="pager__link pager__link--newer" href={postUrl(newer)} rel="next">
                <span class="label">
                  Newer <Icon name="arrow-right" />
                </span>
                <span class="pager__title">{newer.data.title}</span>
              </a>
            )
          }
        </nav>

        {
          more.length > 0 && (
            <div class="related">
              <h3 class="label">Related</h3>
              <ul role="list">
                {more.map((candidate) => (
                  <li>
                    <a href={postUrl(candidate)}>
                      <span class="related__title">{candidate.data.title}</span>
                      <span class="related__date">{formatDate.short(candidate.data.pubDate)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>
  </div>
</Base>


<style>
  /* Reading progress: CSS scroll-driven animation, no JavaScript */
  .progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      position: fixed;
      inset: 0 0 auto;
      z-index: 50;
      height: 3px;
      background: var(--signal);
      transform-origin: 0 50%;
      animation: progress linear both;
      animation-timeline: scroll(root);
    }

    @keyframes progress {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }

  /*
   * The article is one plate. Its head is a signal band across the top;
   * below it, the facts rail and the reading column. The side columns are
   * the plate's padding.
   */
  .article {
    display: grid;
    grid-template-columns: var(--plate-pad) minmax(0, 1fr) var(--plate-pad);
    grid-template-areas:
      'head head head'
      '. rail .'
      '. body .'
      '. foot .';
    margin-top: var(--section);
    padding-bottom: var(--plate-pad);
  }

  .article__head {
    grid-area: head;
    padding: var(--space-7) var(--plate-pad) var(--plate-pad);
    border-bottom: 1px solid var(--edge);
    border-radius: calc(var(--radius-2) - 1px) calc(var(--radius-2) - 1px) 0 0;
    background: var(--signal);
    color: var(--on-signal);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
  }

  .crumbs li + li::before {
    content: '/';
    margin-inline: 0.6em;
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    min-width: 24px;
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .article__title {
    max-width: 52rem;
    margin-top: var(--space-3);
    font-size: var(--step-4);
  }

  .article__dek {
    margin-top: var(--space-4);
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    font-size: var(--step--1);
  }

  .byline img {
    width: 36px;
    height: 36px;
    border: 1px solid var(--edge);
    border-radius: 50%;
    object-fit: cover;
  }

  .byline p {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
  }

  .byline a {
    font-weight: 600;
    text-decoration: none;
  }

  .byline a:hover {
    text-decoration: underline;
  }

  .byline__meta {
    display: flex;
    gap: 0.5em;
  }

  .article__rail {
    grid-area: rail;
    margin-top: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: var(--hairline);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    font-size: var(--step--1);
  }

  .facts dt {
    font-family: var(--display);
    font-size: var(--step--3);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-3);
  }

  /* Every value sits in a 36px row, the height of a topic link, so values line up */
  .facts dd {
    display: grid;
    align-items: center;
    min-height: 36px;
    font-family: var(--mono);
    font-size: var(--step--1);
  }

  .facts ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
  }

  .facts a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    min-width: 24px;
    color: var(--fg);
    text-decoration-color: var(--line-strong);
  }

  .facts a:hover {
    text-decoration-color: var(--accent-mark);
    text-decoration-thickness: 2px;
  }

  /* Byline already shows the date on small screens */
  .facts div:nth-child(2) {
    display: none;
  }

  .toc {
    display: none;
  }

  .article__body {
    grid-area: body;
    max-width: var(--measure);
    margin-top: var(--space-7);
  }

  .article__foot {
    grid-area: foot;
    max-width: var(--measure);
    margin-top: var(--space-8);
  }

  /* The author card: a sticker with an edge in the text colour */
  .author {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--fg);
    border-radius: var(--radius-2);
    background: var(--bg-sunken);
    box-shadow: var(--shadow-hard);
  }

  .author img {
    width: 72px;
    height: 72px;
    border: 1px solid var(--edge);
    border-radius: 50%;
    object-fit: cover;
    background: var(--signal);
  }

  .author__name {
    font-family: var(--display);
    font-size: var(--step-0);
    font-weight: 800;
    margin-bottom: var(--space-1);
  }

  .author p {
    font-size: var(--step--1);
    color: var(--fg-2);
    line-height: 1.6;
  }

  @media (min-width: 64rem) {
    /* The rail and the reading column, left-aligned under the head */
    .article {
      grid-template-columns:
        var(--plate-pad) var(--rail) var(--space-8) minmax(0, var(--measure))
        minmax(var(--plate-pad), 1fr);
      grid-template-areas:
        'head head head head head'
        '. rail . body .'
        '. . . foot .';
    }

    .article__head {
      padding-top: var(--space-9);
    }

    /*
     * A rail taller than the window scrolls inside itself, so the end of a
     * long contents list stays reachable. The padding keeps focus rings and
     * the tick inside the scroll box, and the scroll padding keeps a link
     * that focus scrolls to clear of its edge (Firefox does not scroll a link
     * that is partly in view). The negative margins and the smaller top keep
     * the text where it was.
     */
    .article__rail {
      align-self: start;
      position: sticky;
      top: calc(var(--space-6) - var(--space-2));
      max-height: calc(100dvh - 2 * (var(--space-6) - var(--space-2)));
      overflow-y: auto;
      scroll-padding-block: var(--space-2);
      scrollbar-width: thin;
      margin: calc(var(--space-8) - var(--space-2)) calc(var(--space-3) * -1) 0;
      padding: var(--space-2) var(--space-3);
      border: 0;
    }

    .article__body {
      margin-top: var(--space-8);
    }

    .facts {
      flex-direction: column;
      gap: var(--space-4);
    }

    .facts div:nth-child(2) {
      display: block;
    }

    .facts ul {
      flex-direction: column;
    }

    .toc {
      display: block;
      margin-top: var(--space-6);
      padding-top: var(--space-5);
      border-top: var(--hairline);
    }

    /*
     * Scroll markers: the browser marks the link of the section in view
     * (:target-current), with no JavaScript. Chrome and Edge only for now;
     * other browsers show the plain list.
     */
    .toc ol {
      display: grid;
      margin-top: var(--space-3);
      scroll-target-group: auto;
    }

    /*
     * Each entry is padded to a 36px row for one line of text, so the gap
     * between entries' text is the same whether an entry wraps or not.
     */
    .toc a {
      position: relative;
      display: block;
      padding-block: calc((36px - 1lh) / 2);
      font-size: var(--step--1);
      line-height: 1.4;
      color: var(--fg-3);
      text-decoration: none;
      transition: color var(--dur-1) var(--ease);
    }

    .toc a:hover {
      color: var(--fg);
    }

    /*
     * The section in view looks bold, with a signal tick in the margin. A
     * stroke thickens the letters without changing their width (font-weight
     * would), so a title never re-wraps and the list never jumps.
     */
    .toc a:target-current {
      color: var(--fg);
      -webkit-text-stroke: 0.05em currentColor;
      paint-order: stroke fill;
    }

    .toc a:target-current::before {
      content: '';
      position: absolute;
      top: calc((36px - 1lh) / 2 + 0.2em);
      bottom: calc((36px - 1lh) / 2 + 0.2em);
      left: calc(var(--space-3) * -1);
      width: 3px;
      border-radius: 2px;
      background: var(--signal);
    }
  }

  /* Continue reading: a numbered plate after the article */
  .pager {
    display: grid;
    gap: var(--space-4);
  }

  .pager__link {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-2);
    text-decoration: none;
    transition:
      border-color var(--dur-1) var(--ease),
      box-shadow var(--dur-1) var(--ease),
      transform var(--dur-1) var(--ease);
  }

  .pager__link:hover {
    border-color: var(--fg);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pager__link:hover {
      box-shadow: var(--shadow-hard);
      transform: translate(-1px, -1px);
    }
  }

  .pager__link .label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .pager__link .label :global(svg) {
    width: 14px;
    height: 14px;
  }

  .pager__title {
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
    line-height: 1.3;
  }

  .pager__link--newer {
    text-align: right;
    justify-items: end;
  }

  @media (min-width: 48rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  .related {
    margin-top: var(--space-7);
  }

  .related ul {
    margin-top: var(--space-3);
    border-top: var(--hairline);
  }

  .related a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-bottom: var(--hairline);
    text-decoration: none;
  }

  .related__title {
    font-weight: 500;
  }

  .related a:hover .related__title {
    text-decoration: underline;
    text-decoration-color: var(--accent-mark);
    text-decoration-thickness: 2px;
  }

  .related__date {
    flex-shrink: 0;
    font-family: var(--mono);
    font-size: var(--step--2);
    color: var(--fg-3);
  }
</style>
