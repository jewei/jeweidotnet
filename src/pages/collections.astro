---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { ogPath, pages } from '../data/pages';
import { personId } from '../site.config';
import { absolute, breadcrumbSchema } from '../lib/seo';

const page = pages.collections;

const principles = [
  'Treat software as craft: small systems, deliberate details, and code shaped with care.',
  'Speed is welcome. It does not replace clean architecture, good developer experience, or systems designed to age well.',
  'Precision matters, but so do instinct, timing, and knowing when to stop. This is as true in the kitchen as in code.',
];

const groups = [
  {
    title: 'In the work',
    items: ['AI-assisted software delivery', 'Developer experience', 'Systems that stay simple', 'Product architecture'],
  },
  {
    title: 'On the shelf',
    items: ['Psychology', 'Systems thinking', 'Philosophy', 'Science fiction'],
  },
  {
    title: 'Everyday inputs',
    items: ['Photography walks', 'Music for deep work', 'Kitchen experiments', 'Quiet product details'],
  },
];

const schema = [
  {
    '@type': 'CollectionPage',
    name: 'Collections',
    url: absolute('/collections/'),
    description: page.description,
    author: { '@id': personId },
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about/' },
    { name: 'Collections', path: '/collections/' },
  ]),
];
---

<Base title={page.title} description={page.description} image={ogPath('collections')} schema={schema}>
  <div class="wrap">
    <PageHeader title={page.title} lede={page.card} />

    <section class="part" aria-labelledby="principles-title">
      <header class="part__head"><h2 id="principles-title">Principles</h2></header>
      <div class="part__body">
        <ol class="principles" role="list">
          {
            principles.map((text, index) => (
              <li>
                <span class="principles__no" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <p>{text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="part" aria-labelledby="subjects-title">
      <header class="part__head"><h2 id="subjects-title">Subjects</h2></header>
      <div class="part__body groups">
        {
          groups.map((group) => (
            <section>
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  .principles {
    display: grid;
    max-width: var(--measure);
  }

  .principles li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: var(--hairline);
  }

  .principles li:first-child {
    padding-top: 0;
  }

  .principles__no {
    padding-top: 0.35em;
    font-family: var(--mono);
    font-size: var(--step--2);
    color: var(--accent);
  }

  .principles p {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .groups {
    display: grid;
    gap: var(--space-6);
  }

  .groups h3 {
    font-size: var(--step-0);
  }

  .groups ul {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-3);
    padding-left: 1.1em;
    font-family: var(--serif);
    color: var(--fg-2);
  }

  .groups li::marker {
    color: var(--fg-3);
  }

  @media (min-width: 48rem) {
    .groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
