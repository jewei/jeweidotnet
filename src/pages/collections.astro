---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteUrl, authorName, personId } from '../support/site';

const notes = [
  {
    text: 'I build software with the care of craft: minimal systems, deliberate details, and code I try to shape like art.',
    context: 'Personal note',
  },
  {
    text: 'Speed is fun, but I still obsess over clean architecture, thoughtful DX, and systems designed to age well.',
    context: 'Building principle',
  },
  {
    text: 'Cooking feels a lot like coding: precision matters, but so does instinct, timing, and knowing when to stop tinkering.',
    context: 'Craft note',
  },
];

const groups = [
  {
    title: 'Ideas I keep returning to',
    description: 'Recurring subjects in the work and writing.',
    items: ['AI-assisted software delivery', 'Developer experience', 'Systems that stay simple', 'Product architecture'],
  },
  {
    title: 'Bookshelf themes',
    description: 'Subjects most likely to pull me into another chapter.',
    items: ['Psychology', 'Systems thinking', 'Philosophy', 'Science fiction'],
  },
  {
    title: 'Everyday inputs',
    description: 'Things outside the editor that feed the work.',
    items: ['Photography walks', 'Music for deep work', 'Kitchen experiments', 'Quiet product details'],
  },
];

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Collections',
  url: new URL('/collections/', siteUrl).href,
  description: 'A small, growing index of notes, recurring ideas, books, and everyday inputs kept by Jewei Mak.',
  author: {
    '@type': 'Person',
    '@id': personId,
    name: authorName,
  },
};
---

<BaseLayout
  title="Collections"
  description="A small, growing index of notes, recurring ideas, books, and everyday inputs kept by Jewei Mak."
  socialImageAlt="Collections on jewei.net — notes, recurring ideas, books, and everyday inputs."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} slot="head" />

  <div class="index-page collection-page">
    <header class="index-head">
      <h1>Collections</h1>
      <p>A small, growing index of lines and subjects I want to keep in public view.</p>
    </header>

    <section id="quotes" class="collection-section" aria-labelledby="notes-heading">
      <header class="section-header">
        <h2 id="notes-heading">Notes worth keeping</h2>
        <p>Three working principles, for now.</p>
      </header>

      <ol class="collection-ledger">
        {
          notes.map((note, index) => (
            <li class="collection-note">
              <span class="collection-note__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <blockquote>
                <p>“{note.text}”</p>
                <footer>{note.context}</footer>
              </blockquote>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="insights" class="collection-section" aria-labelledby="subjects-heading">
      <header class="section-header">
        <h2 id="subjects-heading">Recurring subjects</h2>
        <p>This is a reading trail, not a complete taxonomy.</p>
      </header>

      <div class="collection-groups">
        {
          groups.map((group) => (
            <article class="collection-group">
              <h3>{group.title}</h3>
              <p>{group.description}</p>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
