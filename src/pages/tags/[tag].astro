---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tagMap = new Map<string, typeof posts>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const key = tag.toLowerCase().replace(/\s+/g, '-');
      if (!tagMap.has(key)) tagMap.set(key, []);
      tagMap.get(key)!.push(post);
    }
  }

  return [...tagMap.entries()].map(([tagSlug, tagPosts]) => ({
    params: { tag: tagSlug },
    props: {
      tagName: tagPosts[0].data.tags.find(
        t => t.toLowerCase().replace(/\s+/g, '-') === tagSlug
      ) ?? tagSlug,
      posts: tagPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { tagName, posts } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout title={`Tag: ${tagName}`}>
  <p class="back"><a href="/tags/">&larr; All tags</a></p>
  <h1 class="page-title">{tagName}</h1>
  <ul class="post-list">
    {posts.map(post => (
      <li>
        <a href={`/${post.id.replace(/\.mdx?$/, '')}/`}>{post.data.title}</a>
        <time datetime={post.data.pubDate.toISOString()}>
          {dateFormatter.format(post.data.pubDate)}
        </time>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .back { margin-bottom: 0.5rem; font-size: 0.9rem; }
  .page-title { font-size: 1.5rem; margin-top: 0; margin-bottom: 2rem; }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-list a {
    font-weight: 500;
    text-decoration: none;
    color: var(--fg);
  }

  .post-list a:hover { color: var(--link); }

  .post-list time {
    color: var(--muted);
    font-size: 0.875rem;
    white-space: nowrap;
  }
</style>
