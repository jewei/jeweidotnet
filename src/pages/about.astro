---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/jewei.jpg';
import { ogPath, pages } from '../data/pages';
import { site } from '../site.config';
import { absolute, breadcrumbSchema, personSchema } from '../lib/seo';

const page = pages.about;

const pursuits = [
  {
    title: 'Photography',
    text: 'The right light, expression, or quiet detail at the right moment. Portraits, landscapes, and everyday scenes.',
  },
  {
    title: 'Books',
    text: 'Psychology, systems thinking, philosophy, and science fiction: anything that makes the world clearer, or stranger.',
  },
  {
    title: 'Cooking',
    text: 'Close to programming. Precision matters, but so do instinct, timing, and knowing when to stop.',
  },
  {
    title: 'Music',
    text: 'The right song can reset a mood or sharpen a thought.',
  },
];

const elsewhere = [
  { href: site.profiles.github, label: 'GitHub' },
  { href: site.profiles.x, label: 'X' },
  { href: site.profiles.sponsor, label: 'GitHub Sponsors' },
];

const schema = [
  {
    '@type': 'ProfilePage',
    name: `About ${site.author}`,
    url: absolute('/about/'),
    description: page.description,
    mainEntity: personSchema({ image: absolute(portrait.src), description: page.description }),
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about/' },
  ]),
];
---

<Base title={page.title} description={page.description} image={ogPath('about')} type="profile" schema={schema}>
  <div class="wrap">
    <header class="intro">
      <div class="intro__copy">
        <h1>About</h1>
        <p class="intro__lede">
          I build backend systems and small tools, and I write notes for people who care how systems work.
        </p>
      </div>
      <Image
        class="intro__portrait"
        src={portrait}
        alt="Portrait of Jewei Mak."
        widths={[176, 240, 360, 480]}
        sizes="(min-width: 64rem) 12rem, 5.5rem"
        layout="none"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </header>

    <section class="part" aria-labelledby="work">
      <header class="part__head"><h2 id="work">Work</h2></header>
      <div class="part__body prose">
        <p>
          I have worked on backend systems for more than fifteen years: product architecture, APIs, payments, and
          infrastructure. The systems have ranged from early product experiments to platforms used by more than a
          million people.
        </p>
        <p>
          Laravel and PHP have been the constant. Around them: Cloudflare, AWS, distributed services, and the
          unglamorous work of moving data and money safely between systems.
        </p>
        <p>
          At Oneverse, I am the team’s Laravel subject-matter expert, and I work on payment integrations, fraud
          prevention, and the service architecture. Before that, I worked on the backend of a national learning
          platform used by more than 10,000 Malaysian schools at FrogAsia, and led backend architecture at ModeFair as
          a principal engineer. The details are in the <a href="/resume/">résumé</a>.
        </p>
        <p>
          The way I work has changed. I write fewer lines by hand and spend more time on boundaries, on directing AI
          coding agents, and on reviewing what they produce. Speed is useful. Clear architecture, good developer
          experience, and systems that age well still matter more.
        </p>
      </div>
    </section>

    <section class="part" aria-labelledby="tools">
      <header class="part__head"><h2 id="tools">Tools</h2></header>
      <div class="part__body prose">
        <p>
          I like small tools with one clear job. <a href="/projects/#claude-meter">Claude Meter</a>,
          <a href="/projects/#bopop">Bopop</a>, <a href="/projects/#uppa">Uppa</a>, and
          <a href="/projects/#typeid-php">TypeID PHP</a> each started as a problem in my own work or a question I
          wanted to test.
        </p>
        <p>
          Some became open-source packages, some became macOS apps, and some are still experiments. Each one teaches
          me something that client work does not.
        </p>
      </div>
    </section>

    <section class="part" aria-labelledby="writing">
      <header class="part__head"><h2 id="writing">Writing</h2></header>
      <div class="part__body prose">
        <p>
          Writing is how I slow the work down enough to understand it. I write about architecture, scale, PHP, tools,
          and building software with AI.
        </p>
        <p>
          I try to publish what another engineer can use: the commands, the trade-offs, the mistakes, and the results.
          The notes are in <a href="/blog/">Writing</a>.
        </p>
      </div>
    </section>

    <section class="part" aria-labelledby="away">
      <header class="part__head"><h2 id="away">Outside work</h2></header>
      <div class="part__body">
        <dl class="pursuits">
          {
            pursuits.map((item) => (
              <div>
                <dt>{item.title}</dt>
                <dd>{item.text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="more">More notes and recurring subjects are in <a class="link" href="/collections/">Collections</a>.</p>
      </div>
    </section>

    <section class="part" aria-labelledby="contact">
      <header class="part__head"><h2 id="contact">Contact</h2></header>
      <div class="part__body">
        <div class="prose">
          <p>
            Email is best: <a href={`mailto:${site.email}`}>{site.email}</a>. Write about a hard software problem, a
            possible collaboration, or code, products, books, photography, or food. I read every message myself.
          </p>
        </div>
        <ul class="elsewhere" role="list">
          {
            elsewhere.map((link) => (
              <li>
                <a class="arrow-link" href={link.href} data-external>
                  <span>{link.label}</span>
                  <Icon name="arrow-up-right" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8);
  }

  h1 {
    font-size: var(--step-4);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .intro__lede {
    margin-top: var(--space-4);
    max-width: var(--measure);
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--fg-2);
  }

  .intro__portrait {
    order: -1;
    width: 5.5rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-2);
  }

  /* Portrait in the rail, text in the body, as on the home page */
  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      gap: var(--space-6);
      padding-block: var(--space-9);
    }

    .intro__copy {
      grid-column: 2;
      align-self: end;
    }

    .intro__portrait {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
    }
  }

  .part__body {
    max-width: var(--measure);
  }

  .pursuits {
    display: grid;
    border-top: var(--hairline);
  }

  .pursuits div {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-bottom: var(--hairline);
  }

  .pursuits dt {
    font-weight: 600;
  }

  .pursuits dd {
    font-family: var(--serif);
    line-height: 1.6;
    color: var(--fg-2);
  }

  @media (min-width: 40rem) {
    .pursuits div {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  .more {
    margin-top: var(--space-5);
    color: var(--fg-2);
  }

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin-top: var(--space-3);
  }
</style>
