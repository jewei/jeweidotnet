---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<Base
  title="Page not found"
  description="The requested page does not exist or has moved. The work and writing are still here."
  index={false}
  markdown={false}
>
  <div class="wrap lost">
    <p class="label">404</p>
    <h1>Page not found</h1>
    <p class="lost__text">The address may be wrong, or the page may have moved.</p>
    <ul class="lost__actions" role="list">
      <li><a class="arrow-link" href="/"><span>Home</span><Icon name="arrow-right" /></a></li>
      <li><a class="arrow-link" href="/blog/"><span>Writing</span><Icon name="arrow-right" /></a></li>
      <li><a class="arrow-link" href="/projects/"><span>Projects</span><Icon name="arrow-right" /></a></li>
    </ul>

    <section class="lost__latest" aria-labelledby="latest-title">
      <header class="section-head">
        <h2 id="latest-title">Latest writing</h2>
      </header>
      <PostList posts={posts.slice(0, 3)} showTopics={false} />
    </section>
  </div>
</Base>

<style>
  .lost {
    padding-top: var(--space-9);
  }

  h1 {
    margin-top: var(--space-3);
    font-size: var(--step-4);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .lost__text {
    margin-top: var(--space-4);
    max-width: 34rem;
    font-family: var(--serif);
    font-size: var(--step-1);
    color: var(--fg-2);
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin-top: var(--space-5);
  }

  .lost__latest {
    margin-top: var(--section);
  }

  /* The section rule already separates the list from the heading */
  .lost__latest :global(.ledger) {
    border-top: 0;
  }

  .lost__latest :global(.ledger__row:first-child) {
    padding-top: var(--space-2);
  }
</style>
