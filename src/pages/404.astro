---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The requested page does not exist or has moved."
  robots="noindex, nofollow"
  hasMarkdown={false}
  canonical={false}
>
  <div class="not-found">
    <div class="not-found__grid">
      <div class="not-found__visual" aria-hidden="true">
        <span class="not-found__mark">404</span>
        <div class="not-found__code">
          <pre><code>error = null;
while (lost) {'{'}
  wander();
{'}'}</code></pre>
        </div>
      </div>

      <div class="not-found__copy">
        <p class="not-found__status">HTTP 404 · Not found</p>
        <h1 class="not-found__title">This page got lost in the code.</h1>
        <p>
          It may have moved, or it may never have existed. The work and writing are still here.
        </p>
        <div class="not-found__actions">
          <a href="/" class="button-link button-link--primary">
            <Icon name="home" />
            Go home
          </a>
          <a href="/projects/" class="text-link">
            Explore projects
            <span aria-hidden="true">→</span>
          </a>
          <a href="/blog/" class="text-link text-link--quiet">
            Read writing
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
