---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import {
  resumePdfUrl,
  resumeMeta,
  coreStrengths,
  techStack,
  education,
  experience,
} from '../data/resume';
---

<BaseLayout title={resumeMeta.title} description={resumeMeta.summary[0]}>
  <!-- Split Studio opening -->
  <section class="resume-head">
    <div class="space-y-4">
      <div
        class="resume-status"
      >
        <Icon name="spark" class="text-[18px]" />
        <span class="font-label-md text-label-md">Available for Work</span>
      </div>
      <h1 class="resume-title">
        Jewei Mak
      </h1>
      <p class="resume-lede">
        {resumeMeta.headline}
      </p>
    </div>
    <div class="shrink-0">
      <a
        href={resumePdfUrl}
        download
        class="resume-btn-primary w-full sm:w-auto inline-flex items-center justify-center gap-2"
      >
        <Icon name="download" class="text-[20px]" />
        Download PDF Résumé
      </a>
    </div>
  </section>

  <!-- Split Studio body -->
  <div class="resume-layout">
    <!-- Sidebar -->
    <div class="space-y-6 md:space-y-gutter">
      <!-- Summary -->
      <section class="resume-card group">
        <h2 class="resume-section-title">
          <Icon name="person" />
          Summary
        </h2>
        <div
          class="space-y-4 font-body-md text-body-md text-on-surface-variant dark:text-inverse-on-surface/75"
        >
          {resumeMeta.summary.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <!-- Tech stack -->
      <section class="resume-card">
        <h2 class="resume-section-title">
          <Icon name="code" />
          Tech Stack
        </h2>
        <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
          {
            techStack.map((tech) => (
              <li>
                <span class="resume-tag">{tech}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Education -->
      <section class="resume-card">
        <h2 class="resume-section-title">
          <Icon name="school" />
          Education
        </h2>
        <div class="space-y-4">
          {
            education.map((entry) => (
              <div>
                <p class="font-label-md text-label-md text-on-surface-variant dark:text-inverse-on-surface/60">
                  {entry.period}
                </p>
                <h3 class="font-headline-md text-body-lg text-on-surface dark:text-inverse-on-surface font-semibold">
                  {entry.degree}
                </h3>
                <p class="font-body-md text-body-md text-on-surface-variant dark:text-inverse-on-surface/75">
                  {entry.institution}
                </p>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <!-- Main column -->
    <div class="space-y-6 md:space-y-gutter">
      <!-- Core strengths -->
      <section class="resume-card md:p-8">
        <h2 class="resume-section-title">
          <Icon name="insights" />
          Core Strengths
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-x-8 list-none p-0 m-0">
          {
            coreStrengths.map((strength) => (
              <li class="flex gap-2 font-body-md text-body-md text-on-surface-variant dark:text-inverse-on-surface/75">
                <span
                  class="text-primary dark:text-inverse-primary mt-1 shrink-0"
                  aria-hidden="true"
                >
                  ✦
                </span>
                <span>{strength}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Experience -->
      <section class="resume-card md:p-8">
        <h2 class="resume-section-title mb-8">
          <Icon name="work" />
          Experience
        </h2>
        <div class="space-y-8">
          {
            experience.map((role, index) => (
              <article
                class="resume-timeline-item"
                class:list={{ 'resume-timeline-item--last': index === experience.length - 1 }}
                style={`--timeline-opacity: ${Math.max(0.2, 1 - index * 0.12)}`}
              >
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-2">
                  <div>
                    <h3 class="font-display text-headline-md text-on-surface dark:text-inverse-on-surface">
                      {role.title}
                    </h3>
                    {role.companyUrl ? (
                      <a
                        href={role.companyUrl}
                        class="font-body-lg text-primary dark:text-inverse-primary font-medium hover:underline underline-offset-2"
                      >
                        {role.company}
                      </a>
                    ) : (
                      <p class="font-body-lg text-primary dark:text-inverse-primary font-medium">
                        {role.company}
                      </p>
                    )}
                  </div>
                  <span class="resume-period">{role.period}</span>
                </div>
                <ul class="mt-4 space-y-3 list-none p-0 m-0">
                  {role.highlights.map((highlight) => (
                    <li class="flex gap-2 font-body-md text-body-md text-on-surface-variant dark:text-inverse-on-surface/75">
                      <span
                        class="text-primary dark:text-inverse-primary mt-1 shrink-0"
                        aria-hidden="true"
                      >
                        ✦
                      </span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
                {(role.stack || role.tools) && (
                  <div class="mt-4 space-y-1 font-body-md text-sm text-on-surface-variant dark:text-inverse-on-surface/60">
                    {role.stack && (
                      <p>
                        <strong class="text-on-surface dark:text-inverse-on-surface/90">
                          Stack:
                        </strong>{' '}
                        {role.stack}
                      </p>
                    )}
                    {role.tools && (
                      <p>
                        <strong class="text-on-surface dark:text-inverse-on-surface/90">
                          Tools:
                        </strong>{' '}
                        {role.tools}
                      </p>
                    )}
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <!-- CTA -->
  <section
    class="resume-card resume-cta mt-10 md:mt-14 p-8 md:p-10 text-center relative overflow-hidden"
  >
    <h2
      class="font-display text-headline-lg text-on-surface dark:text-inverse-on-surface mb-4 relative z-10"
    >
      Interested in working together?
    </h2>
    <p
      class="font-body-lg text-body-lg text-on-surface-variant dark:text-inverse-on-surface/75 mb-8 max-w-xl mx-auto relative z-10"
    >
      I'm open to senior backend roles, consulting, and interesting product engineering challenges.
      Let's build something reliable.
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-4 relative z-10">
      <a href="mailto:jewei@duck.com" class="resume-btn-primary"> Send a Message </a>
      <a href="/about/" class="resume-btn-secondary"> About Me </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Same entrance grammar as the homepage hero: the intro block rises, the
     download CTA follows a beat later. Short — a recruiter is here to read. */
  .resume-hero > * {
    animation: resume-rise 0.6s var(--ease-out-quint) both;
  }

  .resume-hero > *:nth-child(2) {
    animation-delay: 100ms;
  }

  @keyframes resume-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* "Available for Work" reads as a live status; the spark twinkles to say so. */
  .resume-badge :global(svg) {
    animation: none;
  }

  @keyframes spark-twinkle {
    0%,
    100% {
      transform: scale(1) rotate(0deg);
      opacity: 1;
    }
    50% {
      transform: scale(0.82) rotate(20deg);
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .resume-hero > *,
    .resume-badge :global(svg) {
      animation: none;
    }
  }
</style>
