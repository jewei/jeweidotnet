---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { authorName, authorProfiles, personId, siteUrl } from '../support/site';
import {
  resumePdfUrl,
  resumeMeta,
  coreStrengths,
  techStack,
  education,
  experience,
} from '../data/resume';

const resumeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Résumé — Jewei Mak',
  url: new URL('/resume/', siteUrl).href,
  mainEntity: {
    '@type': 'Person',
    '@id': personId,
    name: authorName,
    url: new URL('/about/', siteUrl).href,
    jobTitle: 'Senior Software Engineer',
    description: resumeMeta.summary[0],
    email: 'mailto:jewei@duck.com',
    knowsAbout: coreStrengths,
    sameAs: authorProfiles,
  },
};
---

<BaseLayout
  title={resumeMeta.title}
  description="Résumé of Jewei Mak, a senior software engineer focused on Laravel, backend architecture, APIs, payments, and production systems."
  socialImageAlt="Résumé of Jewei Mak — senior software engineer and Laravel specialist."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(resumeJsonLd)} slot="head" />

  <article class="resume-page">
    <header class="resume-header">
      <div class="resume-header__identity">
        <p class="resume-kicker">Senior software engineer · backend architect</p>
        <h1>Jewei Mak</h1>
        <p class="resume-headline">{resumeMeta.headline}</p>
      </div>

      <div class="resume-actions" role="group" aria-label="Résumé actions">
        <a href={resumePdfUrl} download class="button button--primary resume-download">
          <Icon name="download" />
          Download PDF
        </a>
        <a href="mailto:jewei@duck.com" class="text-link">Email Jewei <span aria-hidden="true">↗</span></a>
      </div>

      <dl class="resume-facts">
        <div>
          <dt>Experience</dt>
          <dd>15+ years</dd>
        </div>
        <div>
          <dt>Systems served</dt>
          <dd>1M+ users</dd>
        </div>
        <div>
          <dt>Payment providers</dt>
          <dd>10+</dd>
        </div>
        <div>
          <dt>Primary stack</dt>
          <dd>Laravel · PHP</dd>
        </div>
      </dl>
    </header>

    <div class="resume-layout">
      <aside class="resume-aside" aria-label="Profile and skills">
        <section class="resume-section">
          <h2>Profile</h2>
          {resumeMeta.summary.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section class="resume-section">
          <h2>Core strengths</h2>
          <ul class="resume-strengths">
            {coreStrengths.map((strength) => <li>{strength}</li>)}
          </ul>
        </section>

        <section class="resume-section">
          <h2>Technology</h2>
          <p class="resume-technology">{techStack.join(' · ')}</p>
        </section>

        <section class="resume-section">
          <h2>Education</h2>
          {
            education.map((entry) => (
              <div class="resume-education">
                <p class="resume-period">{entry.period}</p>
                <h3>{entry.degree}</h3>
                <p>{entry.institution}</p>
              </div>
            ))
          }
        </section>
      </aside>

      <section class="resume-main" aria-labelledby="experience-heading">
        <h2 id="experience-heading">Experience</h2>
        <div class="resume-roles">
          {
            experience.map((role) => (
              <article class="resume-role">
                <header class="resume-role__header">
                  <div>
                    <h3>{role.title}</h3>
                    {role.companyUrl ? (
                      <a href={role.companyUrl} target="_blank" rel="noopener noreferrer" class="resume-company">
                        {role.company}<span class="sr-only"> (opens in new tab)</span>
                      </a>
                    ) : (
                      <p class="resume-company">{role.company}</p>
                    )}
                  </div>
                  <p class="resume-period">{role.period}</p>
                </header>

                <ul class="resume-highlights">
                  {role.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>

                {(role.stack || role.tools) && (
                  <dl class="resume-role__meta">
                    {role.stack && (
                      <div>
                        <dt>Stack</dt>
                        <dd>{role.stack}</dd>
                      </div>
                    )}
                    {role.tools && (
                      <div>
                        <dt>Tools</dt>
                        <dd>{role.tools}</dd>
                      </div>
                    )}
                  </dl>
                )}
              </article>
            ))
          }
        </div>
      </section>
    </div>

    <footer class="resume-contact">
      <h2>Contact</h2>
      <p>I am open to senior backend roles, consulting, and focused product engineering work.</p>
      <p><a href="mailto:jewei@duck.com">jewei@duck.com</a> · <a href="https://github.com/jewei">github.com/jewei</a> · <a href="https://jewei.net">jewei.net</a></p>
    </footer>
  </article>
</BaseLayout>
